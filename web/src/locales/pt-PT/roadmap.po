msgid "No inbox to show a board for."
msgstr "Nenhuma caixa de entrada para mostrar um quadro."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Nenhum"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Desativado"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Ativado: qualquer pessoa com o endereço lê o quadro, e os leitores com sessão iniciada votam e sugerem ideias. Desativado: só a sua equipa o vê, como ferramenta para organizar feedbacks."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Uma resposta, escrita uma única vez, vai para cada conversa de feedback aberta e associada a esta ideia, como você, no canal próprio de cada conversa."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Abertas"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Abrir no quadro público"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Escolha uma ideia do quadro desta caixa de entrada"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Publicado como a sua resposta pública na ideia. O Markdown funciona."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Privada"

#: src/features/roadmap/pages.tsx
