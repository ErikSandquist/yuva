#: src/features/roadmap/Board.tsx
msgid "{linked} linked feedback"
msgstr "Kapcsolt visszajelzések: {linked}"

#: src/features/roadmap/Board.tsx
msgid "{pending} waiting for approval"
msgstr "{pending} vár jóváhagyásra"

