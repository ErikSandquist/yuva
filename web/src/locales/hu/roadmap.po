msgid "Comment (optional)"
msgstr "Megjegyzés (nem kötelező)"

#: src/features/roadmap/Settings.tsx
msgid "Counts page views of the public board without cookies."
msgstr "Sütik nélkül számolja a nyilvános tábla oldalmegtekintéseit."

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Create board"
msgstr "Tábla létrehozása"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Create board ({newKey})"
msgstr "Tábla létrehozása ({newKey})"

#: src/features/roadmap/Settings.tsx
msgid "Delete"
msgstr "Törlés"

#: src/features/roadmap/Settings.tsx
msgid "Delete {boardName}?"
msgstr "Törli a következőt: {boardName}?"

#: src/features/roadmap/Settings.tsx
msgid "Delete board"
msgstr "Tábla törlése"

#: src/features/roadmap/Settings.tsx
msgid "Deletes the board with its ideas, votes, replies and stage history. Linked feedback stays, and its progress too. The public address stops working."
msgstr "Törli a táblát az ötleteivel, szavazataival, válaszaival és a szakaszok előzményeivel együtt. A kapcsolt visszajelzések és azok előrehaladása megmaradnak. A nyilvános cím megszűnik működni."

#: src/features/roadmap/LinkIdeaDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Description"
msgstr "Leírás"

#: src/features/roadmap/Board.tsx
msgid "Drag {title} to another stage"
msgstr "{title} húzása másik szakaszba"

#: src/features/roadmap/MoveDialog.tsx
msgid "Every linked feedback that does not have it yet gets the progress {progress}. Linked feedback: {linked}"
msgstr "Minden kapcsolt visszajelzés, amely még nem rendelkezik a(z) {progress} előrehaladással, megkapja azt. Kapcsolt visszajelzések: {linked}"

#: src/features/roadmap/Settings.tsx
msgid "Everyone's posts are published at once, except those of authors you marked as spam."
msgstr "Mindenki bejegyzései azonnal megjelennek, kivéve azokét a szerzőkét, akiket spamnek jelöltél."

#: src/features/roadmap/Board.tsx
msgid "Hidden"
msgstr "Rejtett"

#: src/features/roadmap/Board.tsx
msgid "Hide"
msgstr "Elrejtés"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Idea started"
msgstr "Ötlet létrehozva"

#: src/features/roadmap/pages.tsx
msgid "Ideas your customers vote on, with the feedback behind them"
msgstr "Ötletek, amelyekre az ügyfeleid szavaznak, a mögöttük álló visszajelzésekkel"

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "Ideas, votes and stages for {inboxName}, with the feedback behind each idea. It stays private until you make it public."
msgstr "Ötletek, szavazatok és szakaszok ehhez: {inboxName}, az egyes ötletek mögötti visszajelzésekkel. Privát marad, amíg nyilvánossá nem teszi."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Ideas: {ideas}"
msgstr "Ötletek: {ideas}"

#: src/features/roadmap/IdeaPane.tsx
msgid "It was unlinked from the idea."
msgstr "Leválasztva az ötletről."

#: src/features/roadmap/Settings.tsx
msgid "Its ideas, votes, replies and stage history are deleted with it."
msgstr "Az ötletei, szavazatai, válaszai és a szakaszok előzményei vele együtt törlődnek."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Link this feedback to an idea…"
msgstr "Visszajelzés kapcsolása ötlethez…"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Link to an idea"
msgstr "Kapcsolás ötlethez"

#: src/features/roadmap/IdeaPane.tsx
msgid "Linked feedback"
msgstr "Kapcsolt visszajelzések"

#: src/features/roadmap/IdeaPane.tsx
msgid "Linked feedback set to {progress}: {set}"
msgstr "A kapcsolt visszajelzések állapota beállítva: {progress}: {set}"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Linked to {title}"
msgstr "Összekapcsolva: {title}"

#: src/features/roadmap/Board.tsx
msgid "Load more"
msgstr "Továbbiak betöltése"

#: src/features/roadmap/pages.tsx
msgid "Make private"
msgstr "Privátra állítás"

#: src/features/roadmap/pages.tsx
msgid "Make private ({publicKey})"
msgstr "Privátra állítás ({publicKey})"

#: src/features/roadmap/pages.tsx
msgid "Make public"
msgstr "Nyilvánossá tétel"

#: src/features/roadmap/pages.tsx
msgid "Make public ({publicKey})"
msgstr "Nyilvánossá tétel ({publicKey})"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Markdown works."
msgstr "A Markdown működik."

#: src/features/roadmap/Settings.tsx
msgid "Moderated"
msgstr "Moderált"

#: src/features/roadmap/MoveDialog.tsx
msgid "Move"
msgstr "Áthelyezés"

#: src/features/roadmap/MoveDialog.tsx
msgid "Move “{title}”"
msgstr "„{title}” áthelyezése"

#: src/features/roadmap/Board.tsx
msgid "Move {title} to a stage"
msgstr "{title} áthelyezése szakaszba"

#: src/features/roadmap/Board.tsx
#: src/features/roadmap/IdeaPane.tsx
msgid "Move to a stage"
msgstr "Áthelyezés szakaszba"

#: src/features/roadmap/MoveDialog.tsx
msgid "Moved to {stage}"
msgstr "Az ötlet áthelyezve ide: {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Név"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Új ötlet ebből a visszajelzésből"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Még nincs tábla. A tulajdonosok és az adminisztrátorok hozzák létre."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Még nincs visszajelzés kapcsolva. Nyisson meg egy visszajelzést, és használja a „Kapcsolás ötlethez” lehetőséget."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Egy ötlet sem egyezik."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Nincs bejövő postafiók, amelyhez táblát lehetne mutatni."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Nincs"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Ki"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Be: a címet ismerő bárki olvashatja a táblát, a bejelentkezett olvasók pedig szavaznak és ötleteket javasolnak. Ki: csak a csapata látja, a visszajelzések rendezésére szolgáló eszközként."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Egyszer megírt válasz érkezik meg minden ehhez az ötlethez kapcsolt nyitott visszajelzés-beszélgetéshez, az Ön nevében, az adott beszélgetés saját csatornáján."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Nyitott"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Megnyitás a nyilvános táblán"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Válasszon ötletet ennek a postafióknak a tábláján"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Az Ön nyilvános válaszaként jelenik meg az ötletnél. A Markdown működik."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Privát"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Privát, csak a csapata látja"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Nyilvános"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Nyilvános oldal"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Az olvasók nem javasolhatnak ötleteket. A szavazatok és a válaszok továbbra is működnek."

#: src/features/roadmap/Board.tsx
msgid "Readers suggested new ideas. Review them before they show on the public board."
msgstr "Az olvasók új ötleteket javasoltak. Nézd át őket, mielőtt megjelennek a nyilvános táblán."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Útiterv"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Útiterv-táblák"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Mentve"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Ötletek keresése"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Beállítások"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Pick an inbox’s board to sort ideas into stages."
msgstr "Mutassa meg ügyfeleinek, min dolgozik, és kapcsolja az egyes ötletek mögötti visszajelzéseket. Válassza ki egy postafiók tábláját, hogy szakaszokba rendezze az ötleteket."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "A név alatt jelenik meg a nyilvános táblán."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Szakasz"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Szakaszok előzményei"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Ötlet indítása"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Ötletet indít az Ötletek szakaszban, és ehhez kapcsolja ezt a visszajelzést. A visszajelzésből csak az alábbi szöveg jelenik meg."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Olvasók javaslatai"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "A cím „nem található” választ ad, amíg nem teszi nyilvánossá a táblát."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "A tábla itt érhető el: {address}. A régi cím továbbra is átirányít, ha megváltoztatja."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Az ötlet még nem lett áthelyezve."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "A kapcsolt visszajelzések előrehaladása nem változik. Kapcsolt visszajelzések: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "A nyilvános tábla beágyazza ezt a csevegést, és a csapata által indított ötletek ide kerülnek."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Ez a tábla már nem létezik, vagy nem látja."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Ennek a postafióknak nincs útiterv-táblája. Először hozzon létre egyet az Útiterv alatt."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Ennek a postafióknak nincs webes csevegőcsatornája. Először adjon hozzá egyet, mert a nyilvános tábla beágyazza."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Title"
msgstr "Cím"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Használj 3–48 betűt, számjegyet és belső kötőjelet."

#: src/features/roadmap/pages.tsx
msgid "View board"
msgstr "Tábla megtekintése"

#: src/features/roadmap/Settings.tsx
msgid "Visibility"
msgstr "Láthatóság"

#: src/features/roadmap/Board.tsx
msgid "Waiting for approval"
msgstr "Jóváhagyásra vár"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Waiting for approval: {pending}"
msgstr "Jóváhagyásra vár: {pending}"
