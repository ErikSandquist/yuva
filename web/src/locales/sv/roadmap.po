msgid "No board yet. Owners and admins create it."
msgstr "Ingen tavla ännu. Ägare och administratörer skapar den."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Ingen feedback är länkad ännu. Öppna en feedback och använd ”Länka till en idé”."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Ingen idé matchar."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Ingen inkorg att visa en tavla för."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Inga"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Av"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "På: alla som har adressen läser tavlan, och inloggade läsare röstar och föreslår idéer. Av: bara ditt team ser den, som ett verktyg för att sortera feedback."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Ett svar, skrivet en gång, går till varje öppen feedbackkonversation som är länkad till den här idén, som dig, på varje konversations egen kanal."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Öppna"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Öppna på den offentliga tavlan"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Välj en idé från den här inkorgens tavla"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Publiceras som ditt offentliga svar på idén. Markdown fungerar."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Privat"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Privat, bara ditt team ser den"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Offentlig"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Offentlig sida"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Läsare kan inte föreslå idéer. Röster och svar fungerar fortfarande."

#: src/features/roadmap/Board.tsx
msgid "Readers suggested new ideas. Review them before they show on the public board."
msgstr "Läsare har föreslagit nya idéer. Granska dem innan de visas på den offentliga tavlan."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Färdplan"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
