msgid "Name"
msgstr "Ime"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Nova ideja iz teh povratnih informacij"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Table še ni. Ustvarijo jo lastniki in skrbniki."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Nobene povratne informacije še ni povezane. Odprite povratno informacijo in uporabite »Poveži z idejo«."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Nobena ideja se ne ujema."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Ni nabiralnika, za katerega bi prikazali tablo."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Brez"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Izklopljeno"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Vklopljeno: vsak z naslovom bere tablo, prijavljeni bralci pa glasujejo in predlagajo ideje. Izklopljeno: vidi jo samo vaša ekipa, kot orodje za razvrščanje povratnih informacij."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "En odgovor, napisan enkrat, gre v vsak odprt pogovor s povratno informacijo, povezan s to idejo, kot vi, po kanalu posameznega pogovora."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Odprto"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Odpri na javni tabli"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Izberite idejo s table tega nabiralnika"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Objavljeno kot vaš javni odgovor na idejo. Markdown deluje."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Zasebno"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Zasebno, vidi jo samo vaša ekipa"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
