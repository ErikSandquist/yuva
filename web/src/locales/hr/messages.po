#: src/app/Gate.tsx
msgid "Yuva on this server is invite only. Ask an owner or admin of your team's workspace for an invitation."
msgstr "Yuva na ovom poslužitelju je samo uz pozivnicu. Zatražite pozivnicu od vlasnika ili administratora radnog prostora vašeg tima."

#: src/features/auth/SignInPage.tsx
msgid "Yuva on this server is invite only. Ask your team for an invitation."
msgstr "Yuva na ovom poslužitelju je samo uz pozivnicu. Zatražite pozivnicu od svog tima."

#: src/features/migrations/Wizard.tsx
msgid "Yuva only reads the help desk. History arrives quietly: no notifications, no auto-replies."
msgstr "Yuva samo čita službu za pomoć. Povijest stiže tiho: bez obavijesti, bez automatskih odgovora."

#: src/features/migrations/Wizard.tsx
msgid "Yuva only reads the mailbox. History arrives quietly: no notifications, no auto-replies."
msgstr "Yuva samo čita pretinac. Povijest stiže tiho: bez obavijesti, bez automatskih odgovora."

#: src/features/migrations/SignInConnectStep.tsx
msgid "Yuva only reads. Besides signing in, its connection sends {provider} nothing but read requests, so no ticket, customer or setting changes."
msgstr "Yuva samo čita. Osim prijave, njezina veza šalje {provider} samo zahtjeve za čitanje pa se nijedan tiket, klijent ni postavka ne mijenja."

#: src/features/migrations/ConnectStep.tsx
msgid "Yuva only reads. It never deletes, moves, archives or marks anything as read in {provider}, and your mail stays where it is."
msgstr "Yuva samo čita. Nikad ništa ne briše, ne premješta, ne arhivira niti označava kao pročitano kod {provider}, a vaša pošta ostaje gdje jest."

#: src/features/migrations/Wizard.tsx
msgid "Yuva reads only the file you upload and deletes it when the migration ends. History arrives quietly: no notifications, no auto-replies."
msgstr "Yuva čita samo datoteku koju učitate i briše je kad migracija završi. Povijest stiže tiho: bez obavijesti, bez automatskih odgovora."

#: src/features/settings/webhooks/WebhookWizard.tsx
msgid "Yuva sends a signed POST request with a JSON body for every event you pick."
msgstr "Yuva šalje potpisan POST zahtjev s JSON tijelom za svaki odabrani događaj."

#: src/features/migrations/SignInConnectStep.tsx
msgid "Yuva signs in to {provider} with an OAuth client you create in your own account, and only reads."
msgstr "Yuva se prijavljuje u {provider} OAuth klijentom koji izradite u svom računu i samo čita."

#: src/features/settings/channels/email/Deliverability.tsx
msgid "Yuva signs this channel’s broadcasts, tests, confirmation and welcome mails with its own key, over the unsubscribe headers. Your provider’s signature stays next to it; support replies are not changed."
msgstr "Yuva potpisuje masovne poruke, testove, poruke potvrde i dobrodošlice ovog kanala vlastitim ključem, preko zaglavlja za odjavu. Potpis vašeg pružatelja ostaje uz njega; odgovori podrške se ne mijenjaju."

#: src/features/settings/channels/email/Deliverability.tsx
msgid "Yuva stops signing with it at once. Remove the DNS record afterwards; a new key needs a new record."
msgstr "Yuva odmah prestaje potpisivati njime. Poslije uklonite DNS zapis; novi ključ treba novi zapis."

#: src/features/migrations/text.ts
msgid "Yuva stored nothing. Give the app registration only the permissions IMAP.AccessAsUser.All and offline_access, then sign in again."
msgstr "Yuva nije ništa pohranila. Dajte registraciji aplikacije samo dopuštenja IMAP.AccessAsUser.All i offline_access pa se prijavite ponovno."

#: src/features/migrations/text.ts
msgid "Yuva stored nothing. Make sure the OAuth client asks for nothing more than read, then sign in again."
msgstr "Yuva nije ništa pohranila. Provjerite da OAuth klijent ne traži ništa više od čitanja pa se prijavite ponovno."

#: src/features/migrations/text.ts
msgid "Yuva stored nothing. Sign in again; if this keeps happening, tell the operator of this Yuva server."
msgstr "Yuva nije ništa pohranila. Prijavite se ponovno; ako se to ponavlja, recite operateru ovog Yuva poslužitelja."

#: src/features/settings/webhooks/sections.tsx
msgid "Yuva turned this endpoint off on {disabledAt}."
msgstr "Yuva je ovu krajnju točku isključila {disabledAt}."

#: src/features/settings/webhooks/sections.tsx
msgid "Yuva turned this endpoint off."
msgstr "Yuva je ovu krajnju točku isključila."

#: src/components/common/text.ts
msgid "Yuva's own notes cannot be changed."
msgstr "Yuvine vlastite bilješke ne mogu se mijenjati."
