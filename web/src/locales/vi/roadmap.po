msgid "Moved to {stage}"
msgstr "Đã chuyển ý tưởng sang {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Tên"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Ý tưởng mới từ phản hồi này"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Chưa có bảng. Chủ sở hữu và quản trị viên tạo bảng."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Chưa có phản hồi nào được liên kết. Hãy mở một phản hồi và dùng “Liên kết với ý tưởng”."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Không có ý tưởng nào khớp."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Không có hộp thư đến nào để hiển thị bảng."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Không có"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Tắt"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Bật: ai có địa chỉ đều đọc được bảng, và người đọc đã đăng nhập có thể bỏ phiếu và đề xuất ý tưởng. Tắt: chỉ nhóm của bạn thấy, như một công cụ để phân loại phản hồi."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Một câu trả lời, viết một lần, được gửi đến mọi cuộc trò chuyện phản hồi đang mở đã liên kết với ý tưởng này, với tư cách bạn, qua kênh riêng của từng cuộc trò chuyện."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Mở"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Mở trên bảng công khai"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Chọn một ý tưởng từ bảng của hộp thư đến này"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Được đăng dưới dạng câu trả lời công khai của bạn cho ý tưởng. Hỗ trợ Markdown."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Riêng tư"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Riêng tư, chỉ nhóm của bạn thấy"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Công khai"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Trang công khai"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Người đọc không thể đề xuất ý tưởng. Phiếu bầu và câu trả lời vẫn hoạt động."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Lộ trình"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Bảng lộ trình"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Đã lưu"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Tìm ý tưởng"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Cài đặt"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Pick an inbox’s board to sort ideas into stages."
msgstr "Cho khách hàng thấy bạn đang xây dựng gì và liên kết các phản hồi đằng sau mỗi ý tưởng. Chọn bảng của một hộp thư đến để sắp xếp ý tưởng theo giai đoạn."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "Hiển thị bên dưới tên trên bảng công khai."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Giai đoạn"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Lịch sử giai đoạn"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Bắt đầu ý tưởng"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Bắt đầu một ý tưởng ở giai đoạn Ý tưởng và liên kết phản hồi này với nó. Từ phản hồi, chỉ có văn bản bên dưới được hiển thị."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Đề xuất từ người đọc"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "Địa chỉ trả lời “không tìm thấy” cho đến khi bạn công khai bảng."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "Bảng nằm tại {address}. Địa chỉ cũ vẫn chuyển hướng nếu bạn đổi."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Ý tưởng chưa được chuyển."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "Tiến độ của các phản hồi đã liên kết không thay đổi. Phản hồi đã liên kết: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "Bảng công khai nhúng cuộc trò chuyện này, và các ý tưởng nhóm bạn bắt đầu được lưu vào đó."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Bảng này không còn tồn tại hoặc bạn không thể xem."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Hộp thư đến này chưa có bảng lộ trình. Hãy tạo một bảng trước trong Lộ trình."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Hộp thư đến này chưa có kênh trò chuyện web. Hãy thêm một kênh trước, vì bảng công khai nhúng nó."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Title"
msgstr "Tiêu đề"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Dùng 3 đến 48 chữ cái, chữ số và dấu gạch ngang ở giữa."

#: src/features/roadmap/pages.tsx
msgid "View board"
msgstr "Xem bảng"

#: src/features/roadmap/Settings.tsx
msgid "Visibility"
msgstr "Chế độ hiển thị"

#: src/features/roadmap/Board.tsx
msgid "Waiting for approval"
msgstr "Đang chờ duyệt"

