msgstr "Xóa {boardName}?"

#: src/features/roadmap/Settings.tsx
msgid "Delete board"
msgstr "Xóa bảng"

#: src/features/roadmap/Settings.tsx
msgid "Deletes the board with its ideas, votes, replies and stage history. Linked feedback stays, and its progress too. The public address stops working."
msgstr "Xóa bảng cùng các ý tưởng, phiếu bầu, câu trả lời và lịch sử giai đoạn. Phản hồi đã liên kết và tiến độ của chúng vẫn được giữ lại. Địa chỉ công khai ngừng hoạt động."

#: src/features/roadmap/LinkIdeaDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Description"
msgstr "Mô tả"

#: src/features/roadmap/Board.tsx
msgid "Drag {title} to another stage"
msgstr "Kéo {title} sang giai đoạn khác"

#: src/features/roadmap/MoveDialog.tsx
msgid "Every linked feedback that does not have it yet gets the progress {progress}. Linked feedback: {linked}"
msgstr "Mọi phản hồi đã liên kết chưa có tiến độ {progress} sẽ nhận tiến độ đó. Phản hồi đã liên kết: {linked}"

#: src/features/roadmap/Settings.tsx
msgid "Everyone's posts are published at once, except those of authors you marked as spam."
msgstr "Bài đăng của mọi người được đăng ngay, trừ bài của những tác giả bạn đã đánh dấu là thư rác."

#: src/features/roadmap/Board.tsx
msgid "Hidden"
msgstr "Đã ẩn"

#: src/features/roadmap/Board.tsx
msgid "Hide"
msgstr "Ẩn"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Idea started"
msgstr "Đã tạo ý tưởng"

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "Ideas, votes and stages for {inboxName}, with the feedback behind each idea. It stays private until you make it public."
msgstr "Ý tưởng, phiếu bầu và giai đoạn cho {inboxName}, cùng các phản hồi đằng sau mỗi ý tưởng. Bảng vẫn ở chế độ riêng tư cho đến khi bạn công khai."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Ideas: {ideas}"
msgstr "Ý tưởng: {ideas}"

#: src/features/roadmap/IdeaPane.tsx
msgid "It was unlinked from the idea."
msgstr "Đã gỡ liên kết khỏi ý tưởng."

#: src/features/roadmap/Settings.tsx
msgid "Its ideas, votes, replies and stage history are deleted with it."
msgstr "Các ý tưởng, phiếu bầu, câu trả lời và lịch sử giai đoạn của bảng sẽ bị xóa cùng với nó."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Link this feedback to an idea…"
msgstr "Liên kết phản hồi này với một ý tưởng…"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Link to an idea"
msgstr "Liên kết với ý tưởng"

#: src/features/roadmap/IdeaPane.tsx
msgid "Linked feedback"
msgstr "Phản hồi đã liên kết"

#: src/features/roadmap/IdeaPane.tsx
msgid "Linked feedback set to {progress}: {set}"
msgstr "Phản hồi đã liên kết được đặt thành {progress}: {set}"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Linked to {title}"
msgstr "Đã liên kết với {title}"

#: src/features/roadmap/Board.tsx
msgid "Load more"
msgstr "Tải thêm"

