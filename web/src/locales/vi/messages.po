msgstr "{provider} đã cấp nhiều quyền hơn quyền chỉ đọc"

#: src/features/migrations/SwitchStep.tsx
msgid "{provider} keeps its copy, so the old mailbox stays complete."
msgstr "{provider} giữ bản sao của nó, nên hộp thư cũ vẫn đầy đủ."

#: src/features/migrations/ConnectStep.tsx
msgid "{provider} lets other apps in with an app password, a separate password just for Yuva."
msgstr "{provider} cho phép các ứng dụng khác truy cập bằng mật khẩu ứng dụng, một mật khẩu riêng chỉ dành cho Yuva."

#: src/features/migrations/text.ts
msgid "{provider} limits this account for now. Wait a while, then test again."
msgstr "{provider} đang tạm giới hạn tài khoản này. Hãy chờ một lúc rồi kiểm tra lại."

#: src/features/migrations/text.ts
msgid "{provider} refused the sign-in"
msgstr "{provider} đã từ chối đăng nhập"

#: src/features/migrations/ConnectStep.tsx
msgid "{provider} stopped accepting Yuva's sign-in. Enter a new app password; the migration continues where it stopped."
msgstr "{provider} đã ngừng chấp nhận đăng nhập của Yuva. Hãy nhập mật khẩu ứng dụng mới; quá trình di chuyển sẽ tiếp tục từ chỗ đã dừng."

#: src/features/migrations/SignInConnectStep.tsx
msgid "{provider} stopped accepting Yuva's sign-in. Sign in again to the same account; the migration continues where it stopped."
msgstr "{provider} đã ngừng chấp nhận đăng nhập của Yuva. Hãy đăng nhập lại vào cùng tài khoản; quá trình di chuyển sẽ tiếp tục từ chỗ đã dừng."

#: src/features/migrations/text.ts
msgid "{provider} wants an app password, not your account's password. Create one with the steps above."
msgstr "{provider} yêu cầu mật khẩu ứng dụng, không phải mật khẩu tài khoản của bạn. Hãy tạo một mật khẩu theo các bước ở trên."

#: src/features/migrations/text.ts
msgid "{provider} wants you to sign in once in the browser. Sign in to your mail on the web, then test again."
msgstr "{provider} yêu cầu bạn đăng nhập một lần trên trình duyệt. Hãy đăng nhập vào thư của bạn trên web, rồi kiểm tra lại."

