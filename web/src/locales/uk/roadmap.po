msgstr "Видалити"

#: src/features/roadmap/Settings.tsx
msgid "Delete {boardName}?"
msgstr "Видалити {boardName}?"

#: src/features/roadmap/Settings.tsx
msgid "Delete board"
msgstr "Видалити дошку"

#: src/features/roadmap/Settings.tsx
msgid "Deletes the board with its ideas, votes, replies and stage history. Linked feedback stays, and its progress too. The public address stops working."
msgstr "Видаляє дошку разом з її ідеями, голосами, відповідями та історією етапів. Прив’язані відгуки та їхній стан залишаються. Публічна адреса перестає працювати."

#: src/features/roadmap/LinkIdeaDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Description"
msgstr "Опис"

#: src/features/roadmap/Board.tsx
msgid "Drag {title} to another stage"
msgstr "Перетягнути {title} на інший етап"

#: src/features/roadmap/MoveDialog.tsx
msgid "Every linked feedback that does not have it yet gets the progress {progress}. Linked feedback: {linked}"
msgstr "Кожен прив’язаний відгук, який ще не має стану {progress}, отримає його. Прив’язаних відгуків: {linked}"

#: src/features/roadmap/Settings.tsx
msgid "Everyone's posts are published at once, except those of authors you marked as spam."
msgstr "Повідомлення всіх публікуються одразу, крім повідомлень авторів, яких ви позначили як спам."

#: src/features/roadmap/Board.tsx
msgid "Hidden"
msgstr "Приховано"

#: src/features/roadmap/Board.tsx
msgid "Hide"
msgstr "Приховати"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Idea started"
msgstr "Ідею створено"

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "Ideas, votes and stages for {inboxName}, with the feedback behind each idea. It stays private until you make it public."
msgstr "Ідеї, голоси та етапи для {inboxName} з відгуками, що стоять за кожною ідеєю. Дошка лишається закритою, доки ви не зробите її публічною."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Ideas: {ideas}"
msgstr "Ідеї: {ideas}"

#: src/features/roadmap/IdeaPane.tsx
msgid "It was unlinked from the idea."
msgstr "Прив’язку до ідеї знято."

#: src/features/roadmap/Settings.tsx
msgid "Its ideas, votes, replies and stage history are deleted with it."
msgstr "Її ідеї, голоси, відповіді та історія етапів видаляються разом із нею."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Link this feedback to an idea…"
msgstr "Прив’язати цей відгук до ідеї…"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Link to an idea"
msgstr "Прив’язати до ідеї"

#: src/features/roadmap/IdeaPane.tsx
msgid "Linked feedback"
msgstr "Прив’язані відгуки"

#: src/features/roadmap/IdeaPane.tsx
