msgstr "Рахує перегляди сторінок публічної дошки без файлів cookie."

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Create board"
msgstr "Створити дошку"

