msgstr "Прив’язаним відгукам встановлено стан {progress}: {set}"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Linked to {title}"
msgstr "Прив’язано до інциденту {title}"

#: src/features/roadmap/Board.tsx
msgid "Load more"
msgstr "Завантажити ще"

#: src/features/roadmap/pages.tsx
msgid "Make private"
msgstr "Зробити закритою"

