msgid "Make private ({publicKey})"
msgstr "Зробити закритою ({publicKey})"

#: src/features/roadmap/pages.tsx
msgid "Make public"
msgstr "Зробити публічною"

#: src/features/roadmap/pages.tsx
msgid "Make public ({publicKey})"
msgstr "Зробити публічною ({publicKey})"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Markdown works."
msgstr "Markdown підтримується."

#: src/features/roadmap/Settings.tsx
msgid "Moderated"
msgstr "З модерацією"

#: src/features/roadmap/MoveDialog.tsx
msgid "Move"
msgstr "Перенести"

#: src/features/roadmap/MoveDialog.tsx
msgid "Move “{title}”"
msgstr "Перенести «{title}»"

#: src/features/roadmap/Board.tsx
msgid "Move {title} to a stage"
msgstr "Перенести {title} на етап"

#: src/features/roadmap/Board.tsx
#: src/features/roadmap/IdeaPane.tsx
msgid "Move to a stage"
msgstr "Перенести на етап"

#: src/features/roadmap/MoveDialog.tsx
msgid "Moved to {stage}"
msgstr "Ідею перенесено на етап {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Ім'я"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Нова ідея з цього відгуку"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Дошки ще немає. Її створюють власники й адміністратори."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Прив’язаних відгуків ще немає. Відкрийте відгук і виберіть «Прив’язати до ідеї»."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Немає відповідних ідей."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Немає поштової скриньки, для якої можна показати дошку."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Немає"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Вимк."

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Увімкнено: кожен, хто знає адресу, читає дошку, а читачі, що ввійшли, голосують і пропонують ідеї. Вимкнено: її бачить лише ваша команда, як інструмент для сортування відгуків."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Одна відповідь, написана один раз, надходить у кожну відкриту розмову з відгуком, прив’язану до цієї ідеї, від вашого імені, власним каналом кожної розмови."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Відкрито"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Відкрити на публічній дошці"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Виберіть ідею з дошки цієї скриньки"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Публікується як ваша публічна відповідь під ідеєю. Markdown підтримується."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Закритий"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Закрита, її бачить лише ваша команда"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Публічний"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Публічна сторінка"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Читачі не можуть пропонувати ідеї. Голоси та відповіді й надалі працюють."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Дорожня карта"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Дошки дорожніх карт"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Збережено"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Шукати ідеї"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Налаштування"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Pick an inbox’s board to sort ideas into stages."
msgstr "Покажіть клієнтам, над чим ви працюєте, і прив’яжіть відгуки, що стоять за кожною ідеєю. Виберіть дошку скриньки, щоб розкласти ідеї за етапами."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "Показується під назвою на публічній дошці."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Етап"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Історія етапів"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Створити ідею"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Створює ідею на етапі «Ідеї» та прив’язує до неї цей відгук. З відгуку показується лише текст нижче."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Пропозиції читачів"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "Адреса відповідає «не знайдено», доки ви не зробите дошку публічною."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "Дошка за адресою {address}. Стара адреса й надалі перенаправлятиме, якщо ви її змінете."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Ідею ще не переносили."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "Стан прив’язаних відгуків не змінюється. Прив’язаних відгуків: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "Публічна дошка вбудовує цей чат, а ідеї, які розпочинає ваша команда, зберігаються в ньому."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Цієї дошки більше немає, або ви не можете її бачити."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Ця скринька не має дошки дорожньої карти. Спершу створіть її в розділі «Дорожня карта»."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Ця скринька не має каналу веб-чату. Спершу додайте його, бо публічна дошка його вбудовує."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Title"
msgstr "Назва"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Використовуйте від 3 до 48 літер, цифр і внутрішніх дефісів."

#: src/features/roadmap/pages.tsx
msgid "View board"
msgstr "Переглянути дошку"

#: src/features/roadmap/Settings.tsx
msgid "Visibility"
msgstr "Видимість"

#: src/features/roadmap/Board.tsx
msgid "Waiting for approval"
msgstr "Чекають схвалення"

#: src/features/roadmap/RoadmapColumn.tsx
