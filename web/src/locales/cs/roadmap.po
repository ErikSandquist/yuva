msgid "Move to a stage"
msgstr "Přesunout do fáze"

#: src/features/roadmap/MoveDialog.tsx
msgid "Moved to {stage}"
msgstr "Nápad přesunut do fáze {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Název"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Nový nápad z této zpětné vazby"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Zatím žádná nástěnka. Vytvářejí ji vlastníci a správci."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Zatím není propojena žádná zpětná vazba. Otevřete zpětnou vazbu a použijte „Propojit s nápadem“."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Žádný nápad neodpovídá."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Žádná schránka, pro kterou by se zobrazila nástěnka."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Žádné"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Vyp."

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Zapnuto: kdokoli s adresou čte nástěnku a přihlášení čtenáři hlasují a navrhují nápady. Vypnuto: vidí ji jen váš tým, jako nástroj k třídění zpětné vazby."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Jedna odpověď, napsaná jednou, jde do každé otevřené konverzace se zpětnou vazbou propojené s tímto nápadem, jako vy, kanálem příslušné konverzace."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Otevřené"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Otevřít na veřejné nástěnce"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Vyberte nápad z nástěnky této schránky"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Zveřejní se jako vaše veřejná odpověď u nápadu. Markdown funguje."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Soukromá"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Soukromá, vidí ji jen váš tým"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Veřejná"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Veřejná stránka"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Čtenáři nemohou navrhovat nápady. Hlasy a odpovědi fungují dál."

#: src/features/roadmap/Board.tsx
msgid "Readers suggested new ideas. Review them before they show on the public board."
msgstr "Čtenáři navrhli nové nápady. Zkontrolujte je, než se objeví na veřejné nástěnce."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Plán vývoje"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Nástěnky plánu vývoje"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Uloženo"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Hledat nápady"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Nastavení"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Pick an inbox’s board to sort ideas into stages."
msgstr "Ukažte zákazníkům, co budujete, a propojte zpětnou vazbu za každým nápadem. Vyberte nástěnku schránky a roztřiďte nápady do fází."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "Zobrazuje se pod názvem na veřejné nástěnce."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Fáze"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Historie fází"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Založit nápad"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Založí nápad ve fázi Nápady a propojí s ním tuto zpětnou vazbu. Ze zpětné vazby se zobrazí jen text níže."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Návrhy od čtenářů"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "Adresa odpovídá „nenalezeno“, dokud nástěnku nezveřejníte."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "Nástěnka je na adrese {address}. Stará adresa dál přesměrovává, pokud ji změníte."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Nápad ještě nebyl přesunut."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "Průběh propojené zpětné vazby se nemění. Propojená zpětná vazba: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "Veřejná nástěnka vkládá tento chat a nápady, které založí váš tým, se do něj ukládají."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Tato nástěnka už neexistuje, nebo ji nevidíte."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Tato schránka nemá nástěnku plánu vývoje. Nejprve ji vytvořte v části Plán vývoje."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Tato schránka nemá kanál webového chatu. Nejprve jeden přidejte, protože ho veřejná nástěnka vkládá."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Title"
msgstr "Název"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Použijte 3 až 48 písmen, číslic a vnitřních spojovníků."

#: src/features/roadmap/pages.tsx
msgid "View board"
msgstr "Zobrazit nástěnku"

#: src/features/roadmap/Settings.tsx
msgid "Visibility"
msgstr "Viditelnost"

