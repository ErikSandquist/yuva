msgstr "Adressen svarer “ikke fundet”, indtil du publiserer hjelpecentret."

#: src/features/help/pages.tsx
msgid "The help center as visitors see it now. Drafts are left out."
msgstr "Hjelpecentret, som besøkende ser det nu. Utkastr er udeladt."

#: src/features/help/text.tsx
msgid "The help center does not offer this language. Add it in the settings first."
msgstr "Hjelpecentret tilbyder ikke dette sprog. Tilføj det først i indstillingerne."

#: src/features/help/SettingsTab.tsx
msgid "The help center is at {address}. The old address keeps redirecting if you change it."
msgstr "Hjelpecentret ligger på {address}. Den gamle adresse bliver ved med at omdirigere, hvis du ændrer den."

#: src/features/help/pages.tsx
msgid "The help center is not published. Only your team sees this."
msgstr "Hjelpecentret er ikke publiseret. Kun dit team ser dette."

#: src/features/help/Preview.tsx
msgid "The main language has no text for this article yet."
msgstr "Hovedsproget har endnu ingen tekst til denne artikel."

#: src/features/help/ArticleEditor.tsx
msgid "The original changed after this translation was written. Compare them, then mark it up to date."
msgstr "Originalen er endret etter at denne oversettelsen ble skrevet. Sammenlign dem, og merk den deretter som oppdatert."

#: src/features/help/ArticleEditor.tsx
msgid "The page stops working for visitors. The draft stays, and you can publish it again."
msgstr "Siden holder op med at virke for besøkende. Utkastn bliver, og du kan publisere den igen."

#: src/features/help/SettingsTab.tsx
msgid "The pages offer this chat under “Still need help?”."
msgstr "Siderne tilbyder denne chat under “Brug for mere hjelp?”."

#: src/features/help/ArticleEditor.tsx
msgid "The title needs at least 3 characters"
msgstr "Titlen skal være mindst 3 tegn"

