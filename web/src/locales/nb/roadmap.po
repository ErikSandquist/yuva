msgid "Move “{title}”"
msgstr "Flytt «{title}»"

#: src/features/roadmap/Board.tsx
msgid "Move {title} to a stage"
msgstr "Flytt {title} til en fase"

#: src/features/roadmap/Board.tsx
#: src/features/roadmap/IdeaPane.tsx
msgid "Move to a stage"
msgstr "Flytt til en fase"

#: src/features/roadmap/MoveDialog.tsx
msgid "Moved to {stage}"
msgstr "Idéen er flyttet til {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Navn"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Ny idé fra denne tilbakemeldingen"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Ingen tavle ennå. Eiere og administratorer oppretter den."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Ingen tilbakemeldinger er koblet ennå. Åpne en tilbakemelding og bruk «Koble til en idé»."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Ingen idé passer."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Ingen innboks å vise en tavle for."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Ingen"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Av"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "På: alle med adressen leser tavlen, og innloggede lesere stemmer og foreslår idéer. Av: bare teamet ditt ser den, som et verktøy for å sortere tilbakemeldinger."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Ett svar, skrevet én gang, går til hver åpne tilbakemeldingssamtale som er koblet til denne idéen, som deg, på hver samtales egen kanal."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Åpne"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Åpne på den offentlige tavlen"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Velg en idé fra tavlen til denne innboksen"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Publiseres som ditt offentlige svar på idéen. Markdown fungerer."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Privat"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Privat, bare teamet ditt ser den"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Offentlig"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Offentlig side"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Lesere kan ikke foreslå idéer. Stemmer og svar fungerer fortsatt."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Veikart"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Veikarttavler"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Lagret"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Søk i idéer"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Innstillinger"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Pick an inbox’s board to sort ideas into stages."
msgstr "Vis kundene dine hva du bygger, og koble tilbakemeldingene bak hver idé. Velg tavlen til en innboks for å sortere idéene i faser."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "Vises under navnet på den offentlige tavlen."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Fase"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Fasehistorikk"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Start idéen"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Starter en idé i fasen Idéer og kobler denne tilbakemeldingen til den. Av tilbakemeldingen vises bare teksten nedenfor."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Forslag fra lesere"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "Adressen svarer «ikke funnet» til du gjør tavlen offentlig."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "Tavlen ligger på {address}. Den gamle adressen fortsetter å videresende hvis du endrer den."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Idéen er ikke flyttet ennå."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "Fremdriften til de koblede tilbakemeldingene endres ikke. Koblede tilbakemeldinger: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "Den offentlige tavlen bygger inn denne chatten, og idéer teamet ditt starter, arkiveres på den."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Denne tavlen finnes ikke lenger, eller du kan ikke se den."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Denne innboksen har ingen veikarttavle. Opprett først en under Veikart."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Denne innboksen har ingen webchatkanal. Legg først til en, fordi den offentlige tavlen bygger den inn."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Title"
msgstr "Tittel"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Bruk 3 til 48 bokstaver, tall og indre bindestreker."

#: src/features/roadmap/pages.tsx
msgid "View board"
msgstr "Se tavlen"

#: src/features/roadmap/Settings.tsx
msgid "Visibility"
msgstr "Synlighet"

