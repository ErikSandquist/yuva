#: src/features/roadmap/NewIdeaDialog.tsx
msgid "Title"
msgstr "Titel"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Brug 3 til 48 bogstaver, tal og indre bindestreger."

