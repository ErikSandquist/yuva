msgstr "Færdig"

#: src/features/roadmap/MoveDialog.tsx
msgid "Every linked feedback that does not have it yet gets the progress {progress}. Linked feedback: {linked}"
msgstr "Al tilknyttet feedback, der endnu ikke har fremdriften {progress}, får den. Tilknyttet feedback: {linked}"

#: src/features/roadmap/Settings.tsx
msgid "Everyone's posts are published at once, except those of authors you marked as spam."
msgstr "Alles indlæg udgives med det samme, undtagen indlæg fra forfattere, du har markeret som spam."

#: src/features/roadmap/Board.tsx
msgid "Hidden"
msgstr "Skjult"

#: src/features/roadmap/Board.tsx
msgid "Hide"
msgstr "Skjul"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Idea started"
msgstr "Idé oprettet"

#: src/features/roadmap/pages.tsx
msgid "Ideas your customers vote on, with the feedback behind them"
msgstr "Idéer, dine kunder stemmer på, med feedbacken bag dem"

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "Ideas, votes and stages for {inboxName}, with the feedback behind each idea. It stays private until you make it public."
msgstr "Idéer, stemmer og faser for {inboxName} med feedbacken bag hver idé. Den forbliver privat, til du gør den offentlig."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Ideas: {ideas}"
msgstr "Idéer: {ideas}"

#: src/features/roadmap/NewIdeaDialog.tsx
msgid "It goes into Ideas on the board, where customers can vote on it."
msgstr "Den kommer under Idéer på tavlen, hvor kunder kan stemme på den."

#: src/features/roadmap/IdeaPane.tsx
msgid "It was unlinked from the idea."
msgstr "Den blev løsnet fra idéen."

#: src/features/roadmap/Settings.tsx
msgid "Its ideas, votes, replies and stage history are deleted with it."
msgstr "Dens idéer, stemmer, svar og fasehistorik slettes sammen med den."

