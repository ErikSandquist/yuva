msgid "Moved to {stage}"
msgstr "Idé flyttet til {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Navn"

#: src/features/roadmap/NewIdeaDialog.tsx
#: src/features/roadmap/pages.tsx
msgid "New idea"
msgstr "Ny idé"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Ny idé fra denne feedback"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Ingen tavle endnu. Ejere og administratorer opretter den."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Ingen feedback er knyttet endnu. Åbn en feedback og brug “Knyt til en idé”."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Ingen idé passer."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Ingen indbakke at vise en tavle for."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Ingen"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Fra"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Til: alle med adressen læser tavlen, og loggede læsere stemmer og foreslår idéer. Fra: kun dit team ser den, som et værktøj til at sortere feedback."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Ét svar, skrevet én gang, går til hver åben feedbacksamtale knyttet til denne idé, som dig, på hver samtales egen kanal."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Åbne"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Åbn på den offentlige tavle"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Vælg en idé fra denne indbakkes tavle"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Slås op som dit offentlige svar på idéen. Markdown virker."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Privat"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Privat, kun dit team ser den"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Offentlig"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Offentlig side"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Læsere kan ikke foreslå idéer. Stemmer og svar virker stadig."

#: src/features/roadmap/Board.tsx
msgid "Readers suggested new ideas. Review them before they show on the public board."
msgstr "Læsere har foreslået nye idéer. Gennemse dem, før de vises på den offentlige tavle."

#: src/features/roadmap/Board.tsx
msgid "Review"
msgstr "Gennemgang"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Køreplan"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Køreplanstavler"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Gemt"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Søg i idéer"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Indstillinger"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Create a board for an inbox to sort ideas into stages."
msgstr "Vis dine kunder, hvad du bygger, og tilknyt den feedback, der ligger bag hver idé. Opret en tavle til en postkasse for at sortere idéer i trin."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "Vises under navnet på den offentlige tavle."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Fase"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Fasehistorik"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Start idéen"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Starter en idé i fasen Idéer og knytter denne feedback til den. Af feedbacken vises kun teksten nedenfor."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Forslag fra læsere"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "Adressen svarer “ikke fundet”, indtil du gør tavlen offentlig."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "Tavlen findes på {address}. Den gamle adresse viderestiller fortsat, hvis du ændrer den."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Idéen er ikke flyttet endnu."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "Fremdriften for den tilknyttede feedback ændres ikke. Tilknyttet feedback: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "Den offentlige tavle indlejrer denne chat, og idéer, dit team starter, arkiveres på den."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Denne tavle findes ikke længere, eller du kan ikke se den."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Denne indbakke har ingen køreplanstavle. Opret først en under Køreplan."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Denne indbakke har ingen webchatkanal. Tilføj først en, fordi den offentlige tavle indlejrer den."

