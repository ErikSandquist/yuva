msgstr "Alihkan “{title}”"

#: src/features/roadmap/Board.tsx
msgid "Move {title} to a stage"
msgstr "Alihkan {title} ke peringkat"

#: src/features/roadmap/Board.tsx
#: src/features/roadmap/IdeaPane.tsx
msgid "Move to a stage"
msgstr "Alihkan ke peringkat"

#: src/features/roadmap/MoveDialog.tsx
msgid "Moved to {stage}"
msgstr "Idea dialihkan ke {stage}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "Name"
msgstr "Nama"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "New idea from this feedback"
msgstr "Idea baharu daripada maklum balas ini"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No board yet. Owners and admins create it."
msgstr "Belum ada papan. Pemilik dan pentadbir mencipta papan."

#: src/features/roadmap/IdeaPane.tsx
msgid "No feedback is linked yet. Open a piece of feedback and use Link to an idea."
msgstr "Belum ada maklum balas dipautkan. Buka satu maklum balas dan gunakan “Pautkan kepada idea”."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "No idea matches."
msgstr "Tiada idea yang sepadan."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "No inbox to show a board for."
msgstr "Tiada peti masuk untuk dipaparkan papan."

#: src/features/roadmap/Settings.tsx
msgid "None"
msgstr "Tiada"

#: src/features/roadmap/Settings.tsx
msgid "Off"
msgstr "Mati"

#: src/features/roadmap/Settings.tsx
msgid "On: anyone with the address reads the board, and signed-in readers vote and suggest ideas. Off: only your team sees it, as a tool to sort feedback."
msgstr "Hidup: sesiapa yang mempunyai alamat membaca papan, dan pembaca yang log masuk mengundi serta mencadangkan idea. Mati: hanya pasukan anda melihatnya, sebagai alat untuk mengisih maklum balas."

#: src/features/roadmap/IdeaPane.tsx
msgid "One reply, written once, goes to every open feedback conversation linked to this idea, as you, on each conversation’s own channel."
msgstr "Satu balasan, ditulis sekali, dihantar kepada setiap perbualan maklum balas terbuka yang dipautkan pada idea ini, sebagai anda, melalui saluran setiap perbualan."

#: src/features/roadmap/Settings.tsx
msgid "Open"
msgstr "Terbuka"

#: src/features/roadmap/IdeaPane.tsx
msgid "Open on the public board"
msgstr "Buka pada papan awam"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Pick an idea of this inbox’s board"
msgstr "Pilih idea daripada papan peti masuk ini"

#: src/features/roadmap/MoveDialog.tsx
msgid "Posted as your public reply on the idea. Markdown works."
msgstr "Disiarkan sebagai balasan awam anda pada idea. Markdown berfungsi."

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Private"
msgstr "Persendirian"

#: src/features/roadmap/pages.tsx
msgid "Private, only your team sees it"
msgstr "Persendirian, hanya pasukan anda melihatnya"

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
#: src/features/roadmap/Settings.tsx
msgid "Public"
msgstr "Awam"

#: src/features/roadmap/IdeaPane.tsx
msgid "Public page"
msgstr "Halaman awam"

#: src/features/roadmap/Settings.tsx
msgid "Readers cannot suggest ideas. Votes and replies still work."
msgstr "Pembaca tidak boleh mencadangkan idea. Undi dan balasan masih berfungsi."

#: src/features/roadmap/pages.tsx
#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap"
msgstr "Peta hala tuju"

#: src/features/roadmap/RoadmapColumn.tsx
msgid "Roadmap boards"
msgstr "Papan peta hala tuju"

#: src/features/roadmap/Settings.tsx
msgid "Saved"
msgstr "Disimpan"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Search ideas"
msgstr "Cari idea"

#: src/features/roadmap/pages.tsx
msgid "Settings"
msgstr "Tetapan"

#: src/features/roadmap/pages.tsx
msgid "Show your customers what you are building, and link the feedback behind each idea. Pick an inbox’s board to sort ideas into stages."
msgstr "Tunjukkan kepada pelanggan anda apa yang sedang anda bina, dan pautkan maklum balas di sebalik setiap idea. Pilih papan sesebuah peti masuk untuk mengisih idea mengikut peringkat."

#: src/features/roadmap/Settings.tsx
msgid "Shown under the name on the public board."
msgstr "Dipaparkan di bawah nama pada papan awam."

#: src/features/roadmap/MoveDialog.tsx
msgid "Stage"
msgstr "Peringkat"

#: src/features/roadmap/IdeaPane.tsx
msgid "Stage history"
msgstr "Sejarah peringkat"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Start the idea"
msgstr "Mulakan idea"

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Starts an idea in the Ideas stage and links this feedback to it. Nothing of the feedback is shown except the text below."
msgstr "Memulakan idea pada peringkat Idea dan memautkan maklum balas ini kepadanya. Daripada maklum balas, hanya teks di bawah dipaparkan."

#: src/features/roadmap/Settings.tsx
msgid "Suggestions from readers"
msgstr "Cadangan pembaca"

#: src/features/roadmap/Settings.tsx
msgid "The address answers “not found” until you make the board public."
msgstr "Alamat menjawab “tidak dijumpai” sehingga anda menjadikan papan awam."

#: src/features/roadmap/Settings.tsx
msgid "The board is at {address}. The old address keeps redirecting if you change it."
msgstr "Papan berada di {address}. Alamat lama terus mengubah hala jika anda mengubahnya."

#: src/features/roadmap/IdeaPane.tsx
msgid "The idea has not been moved yet."
msgstr "Idea belum dialihkan."

#: src/features/roadmap/MoveDialog.tsx
msgid "The progress of the linked feedback does not change. Linked feedback: {linked}"
msgstr "Kemajuan maklum balas dipautkan tidak berubah. Maklum balas dipautkan: {linked}"

#: src/features/roadmap/CreateBoardDialog.tsx
#: src/features/roadmap/Settings.tsx
msgid "The public board embeds this chat, and ideas your team starts are filed on it."
msgstr "Papan awam menyemat sembang ini, dan idea yang dimulakan pasukan anda disimpan di dalamnya."

#: src/features/roadmap/pages.tsx
msgid "This board no longer exists or you cannot see it."
msgstr "Papan ini sudah tiada atau anda tidak dapat melihatnya."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "This inbox has no roadmap board. Create one under Roadmap first."
msgstr "Peti masuk ini tiada papan peta hala tuju. Cipta satu dahulu di Peta hala tuju."

#: src/features/roadmap/CreateBoardDialog.tsx
msgid "This inbox has no web chat channel. Add one first, because the public board embeds it."
msgstr "Peti masuk ini tiada saluran sembang web. Tambah satu dahulu, kerana papan awam menyematkannya."

#: src/features/roadmap/LinkIdeaDialog.tsx
msgid "Title"
msgstr "Tajuk"

#: src/features/roadmap/Settings.tsx
msgid "Use 3 to 48 letters, numbers and inner hyphens."
msgstr "Gunakan 3 hingga 48 huruf, nombor dan tanda sempang di dalam."

#: src/features/roadmap/pages.tsx
msgid "View board"
msgstr "Lihat papan"

#: src/features/roadmap/Settings.tsx
msgid "Visibility"
msgstr "Keterlihatan"

#: src/features/roadmap/Board.tsx
msgid "Waiting for approval"
msgstr "Menunggu kelulusan"

