#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "أوشكت على الانتهاء. تحقق من بريدك الوارد وأكّد اشتراكك."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "تحقق من بريدك الوارد للتأكيد."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "اختر قائمة واحدة على الأقل."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "تعذّر الاشتراك. حاول مرة أخرى."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "البريد الإلكتروني"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "أدخل بريدًا إلكترونيًا صالحًا."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "أدخل اسمك."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "أرغب في تلقي رسائل بريد إلكتروني عن {list} من {inbox}. يمكنني إلغاء الاشتراك في أي وقت."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "القوائم"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "سياسة الخصوصية"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "اشتراك"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "جارٍ الاشتراك…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "شكرًا! تم اشتراكك."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "ضع علامة في المربع للموافقة."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "محاولات كثيرة جدًا. انتظر قليلًا وحاول مرة أخرى."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "يبدو أنك غير متصل بالإنترنت."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "ليس لحسابك بريد إلكتروني بعد."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "اسمك"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "اسمك (اختياري)"
