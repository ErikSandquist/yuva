#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Nesten ferdig. Sjekk innboksen og bekreft abonnementet."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Sjekk innboksen for å bekrefte."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Velg minst én liste."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Kunne ikke abonnere. Prøv igjen."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-postadresse"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Skriv inn en gyldig e-postadresse."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Skriv inn navnet ditt."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Jeg vil motta e-poster om {list} fra {inbox}. Jeg kan melde meg av når som helst."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Lister"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Personvernerklæring"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Abonner"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Abonnerer…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Takk! Du abonnerer nå."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Kryss av i ruten for å godta."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "For mange forsøk. Vent litt og prøv igjen."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Du ser ut til å være frakoblet."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Kontoen din har ingen e-postadresse ennå."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Navnet ditt"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Navnet ditt (valgfritt)"
