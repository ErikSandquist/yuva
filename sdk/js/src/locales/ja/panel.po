msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "現在対応できるスタッフがいません。メールアドレスを残していただければ、そちらにも返信をお送りします。"

#: src/panel/chat.ts
msgid "Not sent."
msgstr "未送信です。"

#: src/panel/chat.ts
msgid "Online"
msgstr "オンライン"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "再接続中…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0}を削除"

#: src/panel/chat.ts
msgid "Retry"
msgstr "再試行"

#: src/panel/chat.ts
msgid "Save"
msgstr "保存"

#: src/panel/chat.ts
msgid "Seen"
msgstr "既読"

#: src/panel/chat.ts
msgid "Send"
msgstr "送信"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "メッセージをお送りください。こちらでご返信します。"

#: src/panel/chat.ts
msgid "Sending…"
msgstr "送信中…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "送信済み"

#: src/panel/chat.ts
