msgstr "以前の会話を表示"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "チャットを利用するにはサインインしてください。"

#: src/panel/chat.ts
msgid "Skip"
msgstr "スキップ"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "フィードバックありがとうございます"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "ありがとうございます。返信時にご不在の場合は{known}にメールをお送りします。"

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "ファイルが大きすぎます。"

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "この種類のファイルは受け付けていません。"

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "試行回数が多すぎます。しばらく待ってから、もう一度お試しください。"

#: src/panel/chat.ts
msgid "Try again"
msgstr "再試行"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "入力中…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "通常は{duration}以内に返信します"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "できるだけ早く返信します"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "現在不在です"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "メッセージを入力…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "オフラインのようです。"

#: src/panel/chat.ts
msgid "You:"
msgstr "あなた:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "サインインの有効期限が切れました。ページを再読み込みして、もう一度お試しください。"
