msgstr "{name}が入力中…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "すべての会話"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "ほかに伝えたいことはありますか?(任意)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "ファイルを添付"

#: src/panel/chat.ts
msgid "Attachment"
