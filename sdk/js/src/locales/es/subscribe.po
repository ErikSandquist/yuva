#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Casi listo. Revisa tu bandeja de entrada y confirma tu suscripción."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Revisa tu bandeja de entrada para confirmar."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Elige al menos una lista."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "No se pudo completar la suscripción. Inténtalo de nuevo."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Correo electrónico"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Introduce un correo electrónico válido."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Introduce tu nombre."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Quiero recibir correos sobre {list} de {inbox}. Puedo darme de baja en cualquier momento."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listas"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Política de privacidad"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Suscribirme"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Suscribiendo…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "¡Gracias! Ya estás suscrito."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Marca la casilla para aceptar."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Demasiados intentos. Espera un momento e inténtalo de nuevo."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Parece que no tienes conexión."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Tu cuenta aún no tiene una dirección de correo electrónico."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Tu nombre"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Tu nombre (opcional)"
