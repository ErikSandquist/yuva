#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "लगभग हो गया। अपना इनबॉक्स देखें और सदस्यता की पुष्टि करें।"

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "पुष्टि के लिए अपना इनबॉक्स देखें।"

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "कम से कम एक सूची चुनें।"

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "सदस्यता नहीं ली जा सकी। फिर कोशिश करें।"

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "ईमेल पता"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "सही ईमेल पता दर्ज करें।"

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "अपना नाम दर्ज करें।"

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "{inbox} से {list} के बारे में ईमेल पाने के लिए मेरी सहमति है। सदस्यता कभी भी छोड़ी जा सकती है।"

#: src/subscribe/element.ts
msgid "Lists"
msgstr "सूचियाँ"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "गोपनीयता नीति"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "सदस्यता लें"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "सदस्यता ली जा रही है…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "धन्यवाद! आपने सदस्यता ले ली है।"

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "सहमत होने के लिए बॉक्स पर टिक करें।"

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "बहुत ज़्यादा कोशिशें हो गईं। थोड़ी देर रुकें और फिर कोशिश करें।"

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "लगता है आप ऑफ़लाइन हैं।"

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "आपके खाते में अभी तक कोई ईमेल पता नहीं है।"

#: src/subscribe/element.ts
msgid "Your name"
msgstr "आपका नाम"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "आपका नाम (वैकल्पिक)"
