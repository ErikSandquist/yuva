msgstr "कुछ जोड़ना चाहते हैं? (वैकल्पिक)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "फ़ाइलें जोड़ें"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "अटैचमेंट"

#: src/panel/chat.ts
