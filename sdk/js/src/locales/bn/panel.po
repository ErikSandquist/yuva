#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} লিখছেন…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "সব কথোপকথন"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "আর কিছু যোগ করতে চান? (ঐচ্ছিক)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "ফাইল সংযুক্ত করুন"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "সংযুক্তি"

#: src/panel/chat.ts
msgid "Bad"
msgstr "খারাপ"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "চ্যাট এখন উপলব্ধ নেই।"

#: src/panel/chat.ts
msgid "Close"
msgstr "বন্ধ করুন"

#: src/panel/chat.ts
msgid "Comment"
msgstr "মন্তব্য"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "কথোপকথন"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "আপনার ইমেইল ঠিকানা সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "আপনার রেটিং পাঠানো যায়নি। আবার চেষ্টা করুন।"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "ইমেইল ঠিকানা"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "একটি সঠিক ইমেইল ঠিকানা দিন।"

#: src/panel/chat.ts
msgid "Good"
msgstr "ভালো"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "আমরা কেমন করলাম?"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "লোড হচ্ছে…"

#: src/panel/chat.ts
msgid "Message"
msgstr "বার্তা"

#: src/panel/chat.ts
msgid "Messages"
msgstr "বার্তা"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "নতুন কথোপকথন"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "এখনও কোনো কথোপকথন নেই"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "এখন কেউ উপলব্ধ নেই। আপনার ইমেইল দিন, আমরা সেখানেও উত্তর পাঠাব।"

#: src/panel/chat.ts
msgid "Not sent."
msgstr "পাঠানো হয়নি।"

#: src/panel/chat.ts
msgid "Online"
msgstr "অনলাইন"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "আবার সংযোগ হচ্ছে…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0} সরান"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "সমাধান হয়েছে"

#: src/panel/chat.ts
msgid "Retry"
msgstr "আবার চেষ্টা করুন"

#: src/panel/chat.ts
msgid "Save"
msgstr "সংরক্ষণ করুন"

#: src/panel/chat.ts
msgid "Seen"
msgstr "দেখা হয়েছে"

#: src/panel/chat.ts
msgid "Send"
msgstr "পাঠান"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "আমাদের একটি বার্তা পাঠান, আমরা এখানেই উত্তর দেব।"

#: src/panel/chat.ts
msgid "Sending…"
msgstr "পাঠানো হচ্ছে…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "পাঠানো হয়েছে"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "পুরনো কথোপকথন দেখান"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "আমাদের সঙ্গে চ্যাট করতে সাইন ইন করুন।"

#: src/panel/chat.ts
msgid "Skip"
msgstr "এড়িয়ে যান"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "আপনার মতামতের জন্য ধন্যবাদ"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "ধন্যবাদ! আমরা উত্তর দেওয়ার সময় আপনি না থাকলে {known}-এ ইমেইল করব।"

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "ফাইলটি অনেক বড়।"

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "এই ধরনের ফাইল গ্রহণযোগ্য নয়।"

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "অনেকবার চেষ্টা করা হয়েছে। একটু অপেক্ষা করে আবার চেষ্টা করুন।"

#: src/panel/chat.ts
msgid "Try again"
msgstr "আবার চেষ্টা করুন"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "লিখছেন…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "সাধারণত {duration}-এর মধ্যে উত্তর দেয়"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "আমরা যত দ্রুত পারি উত্তর দেব"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "আমরা এখন নেই"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "একটি বার্তা লিখুন…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "মনে হচ্ছে আপনি অফলাইনে আছেন।"

#: src/panel/chat.ts
msgid "You:"
msgstr "আপনি:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "আপনার সাইন-ইনের মেয়াদ শেষ হয়ে গেছে। পৃষ্ঠাটি রিলোড করে আবার চেষ্টা করুন।"
