msgid "Remove {0}"
msgstr "{0} ஐ அகற்று"

#: src/apps/status.ts
msgid "Resolved"
msgstr "தீர்க்கப்பட்டது"

#: src/apps/status.ts
msgid "Scheduled"
msgstr "திட்டமிடப்பட்டது"

#: src/apps/feedback.ts
msgid "Send feedback"
msgstr "கருத்தை அனுப்பு"

#: src/apps/feedback.ts
msgid "Sending…"
msgstr "அனுப்புகிறது…"

#: src/apps/status.ts
msgid "Slow"
msgstr "மெதுவு"

#: src/apps/subscribe.ts
msgid "Subscribe"
msgstr "சந்தா செலுத்து"

#: src/apps/subscribe.ts
msgid "Subscribing…"
msgstr "சந்தா ஆகிறது…"

#: src/apps/feedback.ts
msgid "Take a screenshot"
msgstr "திரைப்பிடிப்பு எடு"

#: src/apps/feedback.ts
msgid "Tell us more"
msgstr "மேலும் சொல்லுங்கள்"

#: src/apps/feedback.ts
msgid "Thanks for your feedback"
msgstr "உங்கள் கருத்துக்கு நன்றி"

#: src/apps/subscribe.ts
msgid "Thanks! You are subscribed."
msgstr "நன்றி! நீங்கள் சந்தாதாரராகிவிட்டீர்கள்."

#: src/apps/feedback.ts
msgid "The file is too large."
msgstr "கோப்பு மிகப் பெரியது."

#: src/apps/feedback.ts
msgid "The team reads every note. Replies show up in your messages."
msgstr "குழு ஒவ்வொரு குறிப்பையும் படிக்கிறது. பதில்கள் உங்கள் செய்திகளில் தோன்றும்."

#: src/apps/feedback.ts
msgid "This file type is not accepted."
msgstr "இந்தக் கோப்பு வகை ஏற்கப்படாது."

#: src/apps/subscribe.ts
msgid "Tick the box to agree."
msgstr "ஒப்புக்கொள்ள பெட்டியில் டிக் செய்யுங்கள்."

#: src/apps/feedback.ts
#: src/apps/subscribe.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "மிக அதிக முயற்சிகள். சிறிது காத்திருந்து மீண்டும் முயலுங்கள்."

#: src/apps/feedback.ts
msgid "View feedback"
msgstr "கருத்தைக் காண்க"

#: src/apps/feedback.ts
msgid "What do you like?"
msgstr "உங்களுக்கு என்ன பிடிக்கும்?"

#: src/apps/feedback.ts
msgid "What happened, and what did you expect?"
msgstr "என்ன நடந்தது, நீங்கள் என்ன எதிர்பார்த்தீர்கள்?"

#: src/apps/feedback.ts
msgid "What is it about"
msgstr "இது எதைப் பற்றியது?"

#: src/apps/feedback.ts
msgid "What would make this better for you?"
msgstr "இதை உங்களுக்கு எது சிறப்பாக்கும்?"

#: src/apps/feedback.ts
msgid "What's on your mind?"
msgstr "உங்கள் மனதில் என்ன இருக்கிறது?"

#: src/apps/feedback.ts
#: src/apps/subscribe.ts
msgid "You seem to be offline."
msgstr "நீங்கள் ஆஃப்லைனில் இருப்பதாகத் தெரிகிறது."

#: src/apps/subscribe.ts
msgid "you@example.com"
msgstr "you@example.com"
