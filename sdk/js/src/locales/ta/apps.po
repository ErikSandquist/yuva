#: src/apps/status.ts
msgid "Monitoring"
msgstr "கண்காணிக்கப்படுகிறது"

#: src/apps/status.ts
msgid "No open incidents."
msgstr "திறந்த சம்பவங்கள் இல்லை."

#: src/apps/status.ts
msgid "OK"
msgstr "சரி"

#: src/apps/status.ts
msgid "Open status page"
msgstr "நிலைப் பக்கத்தைத் திற"

#: src/apps/feedback.ts
msgid "Other"
msgstr "மற்றவை"

#: src/apps/status.ts
msgid "Partial"
msgstr "பகுதி"

#: src/apps/status.ts
msgid "Partial outage"
msgstr "பகுதி தடங்கல்"

#: src/apps/feedback.ts
msgid "Praise"
msgstr "பாராட்டு"

#. placeholder {0}: file.name
