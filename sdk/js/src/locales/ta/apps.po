msgid "In progress"
msgstr "நடைபெறுகிறது"

#: src/apps/status.ts
msgid "Incidents"
msgstr "சம்பவங்கள்"

#: src/apps/status.ts
msgid "Investigating"
msgstr "ஆராயப்படுகிறது"

#: src/apps/subscribe.ts
msgid "Lists"
msgstr "பட்டியல்கள்"

#: src/apps/subscribe.ts
msgid "Loading…"
msgstr "ஏற்றுகிறது…"

#: src/apps/status.ts
msgid "Maintenance"
