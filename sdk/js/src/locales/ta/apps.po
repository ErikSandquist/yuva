#: src/apps/status.ts
msgid "All systems operational"
msgstr "அனைத்து அமைப்புகளும் இயங்குகின்றன"

#: src/apps/subscribe.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "கிட்டத்தட்ட முடிந்தது. உங்கள் இன்பாக்ஸைப் பார்த்து சந்தாவை உறுதிசெய்யுங்கள்."

#: src/apps/feedback.ts
msgid "Attach files"
msgstr "கோப்புகளை இணை"

#: src/apps/feedback.ts
msgid "Bug"
msgstr "பிழை"

#: src/apps/subscribe.ts
msgid "Choose at least one list."
msgstr "குறைந்தது ஒரு பட்டியலைத் தேர்ந்தெடுங்கள்."

#: src/apps/status.ts
msgid "Completed"
msgstr "முடிந்தது"

#: src/apps/status.ts
msgid "Components"
msgstr "கூறுகள்"

#: src/apps/feedback.ts
msgid "Could not send. Try again."
msgstr "அனுப்ப முடியவில்லை. மீண்டும் முயலுங்கள்."

#: src/apps/subscribe.ts
msgid "Could not subscribe. Try again."
msgstr "சந்தாதாரராக முடியவில்லை. மீண்டும் முயலுங்கள்."

#: src/apps/status.ts
msgid "Degraded performance"
msgstr "செயல்திறன் குறைந்துள்ளது"

#: src/apps/feedback.ts
msgid "Done"
msgstr "முடிந்தது"

#: src/apps/status.ts
msgid "Down"
msgstr "இயங்கவில்லை"

#: src/apps/subscribe.ts
msgid "E-mail address"
msgstr "மின்னஞ்சல் முகவரி"

#: src/apps/subscribe.ts
msgid "Enter a valid e-mail address."
msgstr "சரியான மின்னஞ்சல் முகவரியை உள்ளிடுங்கள்."

#: src/apps/status.ts
msgid "Get notified about incidents"
msgstr "சம்பவங்கள் பற்றிய அறிவிப்பைப் பெறுங்கள்"

#: src/apps/subscribe.ts
msgid "Get updates by e-mail"
msgstr "மின்னஞ்சலில் புதுப்பிப்புகளைப் பெறுங்கள்"

#: src/apps/subscribe.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "{inbox} இடமிருந்து {list} பற்றிய மின்னஞ்சல்களைப் பெற விரும்புகிறேன். எப்போது வேண்டுமானாலும் சந்தாவை ரத்துசெய்யலாம்."

#: src/apps/feedback.ts
msgid "Idea"
msgstr "யோசனை"

#: src/apps/status.ts
msgid "Identified"
msgstr "காரணம் கண்டறியப்பட்டது"

