#: src/status/element.ts
msgid "{count} D"
msgstr "{count} நா"

#: src/status/element.ts
msgid "{name} system status"
msgstr "{name} அமைப்பின் நிலை"

#: src/status/element.ts
msgid "All systems operational"
msgstr "அனைத்து அமைப்புகளும் இயங்குகின்றன"

#: src/status/element.ts
msgid "Degraded performance"
msgstr "செயல்திறன் குறைந்துள்ளது"

#: src/status/element.ts
msgid "Down"
msgstr "இயங்கவில்லை"

#: src/status/element.ts
msgid "Everything is working."
msgstr "எல்லாம் சரியாக இயங்குகிறது."

#: src/status/element.ts
msgid "Last 90 days"
msgstr "கடந்த 90 நாட்கள்"

#: src/status/element.ts
msgid "Last 90 days, {uptime} uptime"
msgstr "கடந்த 90 நாட்கள், இயக்க நேரம் {uptime}"

#: src/status/element.ts
msgid "Maintenance"
msgstr "பராமரிப்பு"

#: src/status/element.ts
msgid "Major outage"
msgstr "பெரிய தடங்கல்"

#: src/status/element.ts
msgid "OK"
msgstr "சரி"

#: src/status/element.ts
msgid "Partial"
msgstr "பகுதி"

#: src/status/element.ts
msgid "Partial outage"
msgstr "பகுதி தடங்கல்"

#: src/status/element.ts
msgid "Slow"
msgstr "மெதுவு"

#: src/status/element.ts
msgid "Status by Yuva"
msgstr "Yuva வழங்கும் நிலை"

#: src/status/element.ts
msgid "Under maintenance"
msgstr "பராமரிப்பில் உள்ளது"
