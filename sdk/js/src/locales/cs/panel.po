#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} píše…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Všechny konverzace"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Chcete ještě něco dodat? (nepovinné)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Přiložit soubory"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Příloha"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Špatné"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "Chat teď není dostupný."

#: src/panel/chat.ts
msgid "Close"
msgstr "Zavřít"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Komentář"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Konverzace"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Váš e-mail se nepodařilo uložit. Zkuste to znovu."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Vaše hodnocení se nepodařilo odeslat. Zkuste to znovu."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "E-mailová adresa"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Zadejte platnou e-mailovou adresu."

#: src/panel/chat.ts
msgid "Good"
msgstr "Dobré"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Jak jsme obstáli?"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Načítání…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Zpráva"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Zprávy"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Nová konverzace"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Zatím žádné konverzace"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Nikdo teď není k dispozici. Zanechte nám e-mail a odpověď pošleme i tam."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Neodesláno."

#: src/panel/chat.ts
msgid "Online"
msgstr "Online"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Znovu se připojuje…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Odebrat {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Vyřešeno"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Zkusit znovu"

#: src/panel/chat.ts
msgid "Save"
msgstr "Uložit"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Přečteno"

#: src/panel/chat.ts
msgid "Send"
msgstr "Odeslat"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Napište nám a odpovíme vám tady."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Odesílání…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Odesláno"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Zobrazit starší konverzace"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Přihlaste se a napište nám."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Přeskočit"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Děkujeme za zpětnou vazbu"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Děkujeme! Pokud nebudete u počítače, až odpovíme, pošleme vám e-mail na {known}."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Soubor je příliš velký."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Tento typ souboru není povolen."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Příliš mnoho pokusů. Chvíli počkejte a zkuste to znovu."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Zkusit znovu"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Píše…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Obvykle odpovídá do {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Odpovíme, jakmile to půjde"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Právě jsme pryč"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Napište zprávu…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Zdá se, že jste offline."

#: src/panel/chat.ts
msgid "You:"
msgstr "Vy:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Platnost vašeho přihlášení vypršela. Načtěte stránku znovu a zkuste to znovu."
