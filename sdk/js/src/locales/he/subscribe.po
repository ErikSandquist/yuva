#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "כמעט סיימנו. בדקו את תיבת הדואר ואשרו את ההרשמה."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "בדקו את תיבת הדואר כדי לאשר."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "בחרו לפחות רשימה אחת."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "ההרשמה נכשלה. נסו שוב."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "כתובת אימייל"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "הזינו כתובת אימייל תקינה."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "הזינו את שמכם."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "אני רוצה לקבל אימיילים על {list} מאת {inbox}. אפשר לבטל את ההרשמה בכל עת."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "רשימות"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "מדיניות פרטיות"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "הרשמה"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "נרשם…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "תודה! נרשמתם."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "סמנו את התיבה כדי להסכים."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "יותר מדי ניסיונות. המתינו רגע ונסו שוב."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "נראה שאתם לא מחוברים לאינטרנט."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "לחשבון שלכם עדיין אין כתובת אימייל."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "השם שלכם"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "השם שלכם (אופציונלי)"
