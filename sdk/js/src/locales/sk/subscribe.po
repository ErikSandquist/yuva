#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Skoro hotovo. Skontrolujte doručenú poštu a potvrďte odber."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Potvrďte odber v doručenej pošte."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Vyberte aspoň jeden zoznam."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Prihlásenie na odber zlyhalo. Skúste to znova."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-mailová adresa"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Zadajte platnú e-mailovú adresu."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Zadajte svoje meno."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Chcem dostávať e-maily o téme {list} od {inbox}. Odber môžem kedykoľvek zrušiť."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Zoznamy"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Zásady ochrany osobných údajov"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Odoberať"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Prihlasuje sa…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Ďakujeme! Odoberáte."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Začiarknutím súhlasíte."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Príliš veľa pokusov. Chvíľu počkajte a skúste to znova."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Zdá sa, že ste offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Váš účet zatiaľ nemá žiadnu e-mailovú adresu."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Vaše meno"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Vaše meno (nepovinné)"
