#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} píše…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Všetky konverzácie"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Chcete ešte niečo doplniť? (nepovinné)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Pripojiť súbory"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Príloha"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Zlé"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "Chat momentálne nie je dostupný."

#: src/panel/chat.ts
msgid "Close"
msgstr "Zavrieť"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Komentár"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Konverzácia"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Váš e-mail sa nepodarilo uložiť. Skúste to znova."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Vaše hodnotenie sa nepodarilo odoslať. Skúste to znova."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "E-mailová adresa"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Zadajte platnú e-mailovú adresu."

#: src/panel/chat.ts
msgid "Good"
msgstr "Dobré"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Ako sme obstáli?"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Načítava sa…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Správa"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Správy"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Nová konverzácia"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Zatiaľ žiadne konverzácie"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Momentálne nie je nikto k dispozícii. Zanechajte nám e-mail a odpoveď pošleme aj tam."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Neodoslané."

#: src/panel/chat.ts
msgid "Online"
msgstr "Online"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Znova sa pripája…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Odstrániť {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Vyriešené"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Skúsiť znova"

#: src/panel/chat.ts
msgid "Save"
msgstr "Uložiť"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Prečítané"

#: src/panel/chat.ts
msgid "Send"
msgstr "Odoslať"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Napíšte nám a odpovieme vám tu."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Odosiela sa…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Odoslané"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Zobraziť staršie konverzácie"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Prihláste sa a napíšte nám."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Preskočiť"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Ďakujeme za spätnú väzbu"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Ďakujeme! Ak nebudete pri počítači, keď odpovieme, pošleme vám e-mail na {known}."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Súbor je príliš veľký."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Tento typ súboru nie je povolený."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Príliš veľa pokusov. Chvíľu počkajte a skúste to znova."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Skúsiť znova"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Píše…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Zvyčajne odpovedá do {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Odpovieme, hneď ako to bude možné"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Momentálne sme preč"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Napíšte správu…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Zdá sa, že ste offline."

#: src/panel/chat.ts
msgid "You:"
msgstr "Vy:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Platnosť vášho prihlásenia vypršala. Načítajte stránku znova a skúste to znova."
