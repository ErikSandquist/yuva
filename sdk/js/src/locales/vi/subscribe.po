#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Sắp xong rồi. Hãy kiểm tra hộp thư đến và xác nhận đăng ký."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Hãy kiểm tra hộp thư đến để xác nhận."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Chọn ít nhất một danh sách."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Không thể đăng ký. Hãy thử lại."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Địa chỉ email"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Nhập địa chỉ email hợp lệ."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Nhập tên của bạn."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Tôi muốn nhận email về {list} từ {inbox}. Tôi có thể hủy đăng ký bất cứ lúc nào."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Danh sách"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Chính sách quyền riêng tư"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Đăng ký"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Đang đăng ký…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Cảm ơn bạn! Bạn đã đăng ký."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Đánh dấu vào ô để đồng ý."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Quá nhiều lần thử. Hãy chờ một lát rồi thử lại."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Có vẻ bạn đang ngoại tuyến."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Tài khoản của bạn chưa có địa chỉ email."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Tên của bạn"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Tên của bạn (không bắt buộc)"
