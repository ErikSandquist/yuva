#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Prawie gotowe. Sprawdź skrzynkę odbiorczą i potwierdź subskrypcję."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Sprawdź skrzynkę odbiorczą, aby potwierdzić."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Wybierz co najmniej jedną listę."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Nie udało się zapisać na listę. Spróbuj ponownie."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Adres e-mail"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Wpisz prawidłowy adres e-mail."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Wpisz swoje imię."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Chcę otrzymywać e-maile o {list} od {inbox}. Mogę się wypisać w dowolnym momencie."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listy"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Polityka prywatności"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Subskrybuj"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Zapisywanie…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Dziękujemy! Jesteś zapisany."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Zaznacz pole, aby wyrazić zgodę."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Zbyt wiele prób. Poczekaj chwilę i spróbuj ponownie."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Wygląda na to, że jesteś offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Twoje konto nie ma jeszcze adresu e-mail."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Twoje imię"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Twoje imię (opcjonalnie)"
