#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Ancora nessuna conversazione"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Al momento non c'è nessuno disponibile. Lascia la tua e-mail e invieremo la risposta anche lì."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Non inviato."

#: src/panel/chat.ts
msgid "Online"
msgstr "Online"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Riconnessione…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Rimuovi {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Risolto"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Riprova"

#: src/panel/chat.ts
msgid "Save"
msgstr "Salva"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Visto"

#: src/panel/chat.ts
msgid "Send"
msgstr "Invia"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Mandaci un messaggio e ti risponderemo qui."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Invio…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Inviato"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Mostra le conversazioni meno recenti"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Accedi per chattare con noi."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Salta"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Grazie per il tuo feedback"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Grazie! Ti scriveremo a {known} se non ci sei quando rispondiamo."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Il file è troppo grande."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Questo tipo di file non è accettato."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Troppi tentativi. Attendi un attimo e riprova."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Riprova"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Sta scrivendo…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Di solito risponde entro {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Risponderemo il prima possibile"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Al momento siamo assenti"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Scrivi un messaggio…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Sembra che tu sia offline."

#: src/panel/chat.ts
msgid "You:"
msgstr "Tu:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "La tua sessione è scaduta. Ricarica la pagina e riprova."
