#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} sta scrivendo…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Tutte le conversazioni"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Vuoi aggiungere qualcosa? (facoltativo)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Allega file"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Allegato"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Male"

