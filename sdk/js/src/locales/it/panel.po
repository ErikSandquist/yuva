msgstr "La chat non è disponibile al momento."

#: src/panel/chat.ts
msgid "Close"
msgstr "Chiudi"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Commento"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Conversazione"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Non è stato possibile salvare il tuo indirizzo e-mail. Riprova."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Non è stato possibile inviare la tua valutazione. Riprova."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "Indirizzo e-mail"

