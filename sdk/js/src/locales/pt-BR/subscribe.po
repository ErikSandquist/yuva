#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Quase lá. Confira sua caixa de entrada e confirme a inscrição."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Confira sua caixa de entrada para confirmar."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Escolha pelo menos uma lista."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Não foi possível se inscrever. Tente novamente."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Endereço de e-mail"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Informe um endereço de e-mail válido."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Informe seu nome."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Quero receber e-mails sobre {list} de {inbox}. Posso cancelar a inscrição a qualquer momento."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listas"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Política de privacidade"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Inscrever-se"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Inscrevendo…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Obrigado! Você está inscrito."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Marque a caixa para concordar."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Muitas tentativas. Aguarde um momento e tente novamente."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Parece que você está offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Sua conta ainda não tem um endereço de e-mail."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Seu nome"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Seu nome (opcional)"
