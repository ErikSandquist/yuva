#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Bijna klaar. Controleer je inbox en bevestig je abonnement."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Controleer je inbox om te bevestigen."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Kies minstens één lijst."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Aanmelden is niet gelukt. Probeer het opnieuw."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-mailadres"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Voer een geldig e-mailadres in."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Voer je naam in."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Ik wil e-mails ontvangen over {list} van {inbox}. Ik kan me op elk moment afmelden."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Lijsten"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Privacybeleid"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Abonneren"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Abonneren…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Bedankt! Je bent geabonneerd."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Vink het vakje aan om akkoord te gaan."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Te veel pogingen. Wacht even en probeer het opnieuw."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Je lijkt offline te zijn."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Je account heeft nog geen e-mailadres."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Je naam"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Je naam (optioneel)"
