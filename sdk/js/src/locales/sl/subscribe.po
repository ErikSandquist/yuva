#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Skoraj končano. Preverite prejeto pošto in potrdite naročnino."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Za potrditev preverite prejeto pošto."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Izberite vsaj en seznam."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Naročanje ni uspelo. Poskusite znova."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-poštni naslov"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Vnesite veljaven e-poštni naslov."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Vnesite svoje ime."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Želim prejemati e-pošto o temi {list} od {inbox}. Naročnino lahko kadar koli prekličem."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Seznami"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Pravilnik o zasebnosti"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Naroči se"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Naročanje …"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Hvala! Naročeni ste."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Označite polje, da se strinjate."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Preveč poskusov. Počakajte trenutek in poskusite znova."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Videti je, da ste brez povezave."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Vaš račun še nima e-poštnega naslova."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Vaše ime"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Vaše ime (neobvezno)"
