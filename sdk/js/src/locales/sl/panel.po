msgstr "Nov pogovor"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Še ni pogovorov"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Trenutno ni nikogar na voljo. Pustite svoj e-poštni naslov in odgovor bomo poslali tudi tja."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Ni poslano."

#: src/panel/chat.ts
msgid "Online"
msgstr "Na spletu"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Ponovno povezovanje …"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Odstrani {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Rešeno"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Poskusi znova"

#: src/panel/chat.ts
msgid "Save"
msgstr "Shrani"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "Načrtovano"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Prebrano"

#: src/panel/chat.ts
msgid "Send"
msgstr "Pošlji"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Pošljite nam sporočilo in odgovorili vam bomo tukaj."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Pošiljanje …"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Poslano"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Pokaži starejše pogovore"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Prijavite se, da se pogovorite z nami."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Preskoči"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Hvala za povratne informacije"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Hvala! Če vas ne bo, ko odgovorimo, vam bomo poslali e-pošto na {known}."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Datoteka je prevelika."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Ta vrsta datoteke ni sprejeta."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Preveč poskusov. Počakajte trenutek in poskusite znova."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Poskusi znova"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Tipka …"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Običajno odgovori v {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Odgovorili bomo, takoj ko bo mogoče"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Trenutno nas ni"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Napišite sporočilo …"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Videti je, da ste brez povezave."

#: src/panel/chat.ts
msgid "You:"
msgstr "Vi:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Vaša prijava je potekla. Znova naložite stran in poskusite znova."
