msgstr "Klepet trenutno ni na voljo."

#: src/panel/chat.ts
msgid "Close"
msgstr "Zapri"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Komentar"

#: src/panel/chat.ts
msgid "Completed"
msgstr "Končano"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Pogovor"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Vašega e-poštnega naslova ni bilo mogoče shraniti. Poskusite znova."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Vaše ocene ni bilo mogoče poslati. Poskusite znova."

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "Opusti"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "E-poštni naslov"

