msgid "Enter a valid e-mail address."
msgstr "Vnesite veljaven e-poštni naslov."

#: src/panel/chat.ts
msgid "Good"
msgstr "Dobro"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Kako smo se odrezali?"

#: src/panel/chat.ts
msgid "Identified"
msgstr "Vzrok ugotovljen"

