#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Σχεδόν έτοιμο. Ελέγξτε τα εισερχόμενά σας και επιβεβαιώστε τη συνδρομή σας."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Ελέγξτε τα εισερχόμενά σας για επιβεβαίωση."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Επιλέξτε τουλάχιστον μία λίστα."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Η εγγραφή δεν ήταν δυνατή. Δοκιμάστε ξανά."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Διεύθυνση email"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Εισαγάγετε μια έγκυρη διεύθυνση email."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Εισαγάγετε το όνομά σας."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Θέλω να λαμβάνω email για {list} από {inbox}. Μπορώ να ακυρώσω τη συνδρομή μου οποιαδήποτε στιγμή."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Λίστες"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Πολιτική απορρήτου"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Εγγραφή"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Εγγραφή…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Ευχαριστούμε! Έχετε εγγραφεί."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Επιλέξτε το πλαίσιο για να συμφωνήσετε."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Πάρα πολλές προσπάθειες. Περιμένετε λίγο και δοκιμάστε ξανά."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Φαίνεται ότι είστε εκτός σύνδεσης."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Ο λογαριασμός σας δεν έχει ακόμη διεύθυνση email."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Το όνομά σας"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Το όνομά σας (προαιρετικό)"
