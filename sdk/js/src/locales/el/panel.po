#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "Ο/Η {name} πληκτρολογεί…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Όλες οι συνομιλίες"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Θέλετε να προσθέσετε κάτι; (προαιρετικό)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Επισύναψη αρχείων"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Συνημμένο"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Άσχημα"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "Η συνομιλία δεν είναι διαθέσιμη αυτή τη στιγμή."

#: src/panel/chat.ts
msgid "Close"
msgstr "Κλείσιμο"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Σχόλιο"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Συνομιλία"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Δεν ήταν δυνατή η αποθήκευση της διεύθυνσης email σας. Δοκιμάστε ξανά."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Δεν ήταν δυνατή η αποστολή της αξιολόγησής σας. Δοκιμάστε ξανά."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "Διεύθυνση email"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Εισαγάγετε μια έγκυρη διεύθυνση email."

#: src/panel/chat.ts
msgid "Good"
msgstr "Καλά"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Πώς τα πήγαμε;"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Φόρτωση…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Μήνυμα"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Μηνύματα"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Νέα συνομιλία"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Δεν υπάρχουν ακόμη συνομιλίες"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Κανείς δεν είναι διαθέσιμος αυτή τη στιγμή. Αφήστε το email σας και θα στείλουμε την απάντηση και εκεί."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Δεν στάλθηκε."

#: src/panel/chat.ts
msgid "Online"
msgstr "Συνδεδεμένος"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Επανασύνδεση…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Αφαίρεση {0}"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Επανάληψη"

#: src/panel/chat.ts
msgid "Save"
msgstr "Αποθήκευση"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Διαβάστηκε"

#: src/panel/chat.ts
msgid "Send"
msgstr "Αποστολή"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Στείλτε μας ένα μήνυμα και θα απαντήσουμε εδώ."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Αποστολή…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Στάλθηκε"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Εμφάνιση παλαιότερων συνομιλιών"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Συνδεθείτε για να συνομιλήσετε μαζί μας."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Παράλειψη"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Ευχαριστούμε για τα σχόλιά σας"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Ευχαριστούμε! Θα σας στείλουμε email στη διεύθυνση {known} αν λείπετε όταν απαντήσουμε."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Το αρχείο είναι πολύ μεγάλο."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Αυτός ο τύπος αρχείου δεν γίνεται δεκτός."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Πάρα πολλές προσπάθειες. Περιμένετε λίγο και δοκιμάστε ξανά."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Δοκιμή ξανά"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Πληκτρολογεί…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Συνήθως απαντά σε {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Θα απαντήσουμε το συντομότερο δυνατό"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Λείπουμε αυτή τη στιγμή"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Γράψτε ένα μήνυμα…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Φαίνεται ότι είστε εκτός σύνδεσης."

#: src/panel/chat.ts
msgid "You:"
msgstr "Εσείς:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Η σύνδεσή σας έληξε. Φορτώστε ξανά τη σελίδα και δοκιμάστε πάλι."
