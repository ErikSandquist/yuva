#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Почти готово. Проверьте почту и подтвердите подписку."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Проверьте почту, чтобы подтвердить."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Выберите хотя бы один список."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Не удалось подписаться. Повторите попытку."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Адрес e-mail"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Введите корректный адрес e-mail."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Введите ваше имя."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Я хочу получать e-mail о {list} от {inbox}. Я могу отписаться в любое время."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Списки"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Политика конфиденциальности"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Подписаться"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Подписка…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Спасибо! Вы подписаны."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Поставьте галочку, чтобы согласиться."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Слишком много попыток. Подождите немного и повторите попытку."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Похоже, вы не в сети."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "В вашем аккаунте пока нет адреса e-mail."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Ваше имя"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Ваше имя (необязательно)"
