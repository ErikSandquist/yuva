msgstr "{name} печатает…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Все диалоги"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Хотите что-нибудь добавить? (необязательно)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Прикрепить файлы"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Вложение"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Плохо"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "Чат сейчас недоступен."

#: src/panel/chat.ts
msgid "Close"
msgstr "Закрыть"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Комментарий"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Диалог"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Не удалось сохранить ваш e-mail. Повторите попытку."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Не удалось отправить вашу оценку. Повторите попытку."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "Адрес e-mail"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Введите корректный адрес e-mail."

#: src/panel/chat.ts
msgid "Good"
msgstr "Хорошо"

#: src/panel/chat.ts
msgid "How did we do?"
