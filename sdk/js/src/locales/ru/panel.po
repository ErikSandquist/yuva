#: src/panel/chat.ts
msgid "Message"
msgstr "Сообщение"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Сообщения"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Новый диалог"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Пока нет диалогов"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Сейчас никого нет на связи. Оставьте свой e-mail, и мы отправим ответ и туда."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Не отправлено."

#: src/panel/chat.ts
msgid "Online"
msgstr "В сети"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Повторное подключение…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Удалить {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Решено"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Повторить"

#: src/panel/chat.ts
msgid "Save"
msgstr "Сохранить"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Прочитано"

#: src/panel/chat.ts
msgid "Send"
msgstr "Отправить"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Напишите нам, и мы ответим здесь."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Отправка…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Отправлено"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Показать более старые диалоги"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Войдите, чтобы пообщаться с нами."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Пропустить"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Спасибо за ваш отзыв"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Спасибо! Если вас не будет на месте, когда мы ответим, мы напишем на {known}."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Файл слишком большой."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Этот тип файла не принимается."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Слишком много попыток. Подождите немного и повторите попытку."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Повторить"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Печатает…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Обычно отвечает за {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Мы ответим как можно скорее"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Сейчас нас нет на месте"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Напишите сообщение…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Похоже, вы не в сети."

#: src/panel/chat.ts
msgid "You:"
msgstr "Вы:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Срок действия вашего входа истёк. Обновите страницу и повторите попытку."
