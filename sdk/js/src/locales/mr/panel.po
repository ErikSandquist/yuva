msgstr "पूर्ण झाले"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "संभाषण"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "तुमचा ईमेल पत्ता सेव्ह करता आला नाही. पुन्हा प्रयत्न करा."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "तुमचे रेटिंग पाठवता आले नाही. पुन्हा प्रयत्न करा."

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "बंद करा"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "ईमेल पत्ता"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "वैध ईमेल पत्ता टाका."

#: src/panel/chat.ts
msgid "Good"
msgstr "चांगले"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "आम्ही कसे होतो?"

#: src/panel/chat.ts
msgid "Identified"
msgstr "कारण ओळखले"

#: src/panel/chat.ts
msgid "In progress"
msgstr "सुरू आहे"

#: src/panel/chat.ts
msgid "Investigating"
msgstr "तपास सुरू आहे"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "लोड होत आहे…"

#: src/panel/chat.ts
msgid "Message"
msgstr "संदेश"

#: src/panel/chat.ts
msgid "Messages"
msgstr "संदेश"

#: src/panel/chat.ts
msgid "Monitoring"
msgstr "देखरेख सुरू आहे"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "नवीन संभाषण"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "अजून कोणतेही संभाषण नाही"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "सध्या कोणीही उपलब्ध नाही. तुमचा ईमेल द्या, आम्ही उत्तर तिथेही पाठवू."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "पाठवले नाही."

#: src/panel/chat.ts
msgid "Online"
msgstr "ऑनलाइन"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "पुन्हा कनेक्ट होत आहे…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0} काढा"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "सोडवले"

#: src/panel/chat.ts
msgid "Retry"
msgstr "पुन्हा प्रयत्न करा"

#: src/panel/chat.ts
msgid "Save"
msgstr "सेव्ह करा"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "नियोजित"

#: src/panel/chat.ts
msgid "Seen"
msgstr "पाहिले"

#: src/panel/chat.ts
msgid "Send"
msgstr "पाठवा"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "आम्हाला संदेश पाठवा, आम्ही इथेच उत्तर देऊ."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "पाठवत आहे…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "पाठवले"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "जुनी संभाषणे दाखवा"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "आमच्याशी चॅट करण्यासाठी साइन इन करा."

#: src/panel/chat.ts
msgid "Skip"
msgstr "वगळा"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "तुमच्या प्रतिक्रियेबद्दल धन्यवाद"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "धन्यवाद! आम्ही उत्तर देताना तुम्ही नसल्यास आम्ही {known} वर ईमेल करू."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "फाइल खूप मोठी आहे."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "हा फाइल प्रकार स्वीकारला जात नाही."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "खूप प्रयत्न झाले. थोडा वेळ थांबा आणि पुन्हा प्रयत्न करा."

#: src/panel/chat.ts
msgid "Try again"
msgstr "पुन्हा प्रयत्न करा"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "टाइप करत आहेत…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "सहसा {duration} मध्ये उत्तर देतात"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "आम्ही शक्य तितक्या लवकर उत्तर देऊ"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "आम्ही सध्या उपलब्ध नाही"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "संदेश लिहा…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "तुम्ही ऑफलाइन असल्याचे दिसते."

#: src/panel/chat.ts
msgid "You:"
msgstr "तुम्ही:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "तुमचे साइन-इन संपले आहे. पेज रीलोड करा आणि पुन्हा प्रयत्न करा."
