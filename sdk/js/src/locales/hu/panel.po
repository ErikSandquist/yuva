#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} éppen ír…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Összes beszélgetés"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Szeretne hozzáfűzni valamit? (nem kötelező)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Fájlok csatolása"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Melléklet"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Rossz"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "A csevegés jelenleg nem érhető el."

#: src/panel/chat.ts
msgid "Close"
msgstr "Bezárás"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Megjegyzés"

#: src/panel/chat.ts
msgid "Completed"
msgstr "Befejezve"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Beszélgetés"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Nem sikerült elmenteni az e-mail-címét. Próbálja újra."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Nem sikerült elküldeni az értékelését. Próbálja újra."

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "Elvetés"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "E-mail-cím"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Adjon meg egy érvényes e-mail-címet."

#: src/panel/chat.ts
msgid "Good"
msgstr "Jó"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Hogy sikerült?"

#: src/panel/chat.ts
msgid "Identified"
msgstr "Az ok azonosítva"

#: src/panel/chat.ts
msgid "In progress"
msgstr "Folyamatban"

#: src/panel/chat.ts
msgid "Investigating"
msgstr "Vizsgálat alatt"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Betöltés…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Üzenet"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Üzenetek"

#: src/panel/chat.ts
msgid "Monitoring"
msgstr "Megfigyelés alatt"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Új beszélgetés"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Még nincsenek beszélgetések"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Jelenleg senki sem érhető el. Hagyja meg az e-mail-címét, és oda is elküldjük a választ."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Nem lett elküldve."

#: src/panel/chat.ts
msgid "Online"
msgstr "Online"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Újracsatlakozás…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0} eltávolítása"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Megoldva"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Újra"

#: src/panel/chat.ts
msgid "Save"
msgstr "Mentés"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "Ütemezve"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Látta"

#: src/panel/chat.ts
msgid "Send"
msgstr "Küldés"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Írjon nekünk, és itt válaszolunk."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Küldés…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Elküldve"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Régebbi beszélgetések megjelenítése"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Jelentkezzen be, hogy csevegjen velünk."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Kihagyás"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Köszönjük a visszajelzését"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Köszönjük! Ha nem lesz ott, amikor válaszolunk, e-mailt küldünk a(z) {known} címre."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "A fájl túl nagy."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Ez a fájltípus nem elfogadott."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Túl sok próbálkozás. Várjon egy pillanatot, és próbálja újra."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Próbálja újra"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Éppen ír…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Általában {duration} alatt válaszol"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Amint tudunk, válaszolunk"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Jelenleg nem vagyunk elérhetők"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Írjon üzenetet…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Úgy tűnik, offline van."

#: src/panel/chat.ts
msgid "You:"
msgstr "Ön:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "A bejelentkezése lejárt. Töltse újra az oldalt, és próbálja újra."
