#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Mindjárt kész. Nézze meg a postaládáját, és erősítse meg a feliratkozást."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "A megerősítéshez nézze meg a postaládáját."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Válasszon legalább egy listát."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "A feliratkozás nem sikerült. Próbálja újra."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-mail-cím"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Adjon meg egy érvényes e-mail-címet."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Adja meg a nevét."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "E-maileket szeretnék kapni a(z) {list} témában a(z) {inbox} részéről. Bármikor leiratkozhatok."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listák"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Adatvédelmi irányelvek"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Feliratkozás"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Feliratkozás…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Köszönjük! Feliratkozott."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "A beleegyezéshez jelölje be a négyzetet."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Túl sok próbálkozás. Várjon egy pillanatot, és próbálja újra."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Úgy tűnik, offline van."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "A fiókjához még nem tartozik e-mail-cím."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Az Ön neve"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Az Ön neve (nem kötelező)"
