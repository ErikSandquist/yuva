msgid "Sign in to chat with us."
msgstr "Melden Sie sich an, um mit uns zu chatten."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Überspringen"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Danke für Ihr Feedback"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Danke! Falls Sie nicht mehr da sind, wenn wir antworten, schreiben wir Ihnen an {known}."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Die Datei ist zu groß."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Dieser Dateityp wird nicht akzeptiert."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Zu viele Versuche. Warten Sie einen Moment und versuchen Sie es erneut."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Erneut versuchen"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Schreibt…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Übliche Antwortzeit: {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Wir antworten so schnell wie möglich"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Wir sind gerade nicht da"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Nachricht schreiben…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Sie scheinen offline zu sein."

#: src/panel/chat.ts
msgid "You:"
msgstr "Sie:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "sie@beispiel.de"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Ihre Anmeldung ist abgelaufen. Laden Sie die Seite neu und versuchen Sie es erneut."
