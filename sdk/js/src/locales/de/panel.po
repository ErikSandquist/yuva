msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Gerade ist niemand erreichbar. Hinterlassen Sie Ihre E-Mail-Adresse, dann senden wir die Antwort auch dorthin."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Nicht gesendet."

#: src/panel/chat.ts
msgid "Online"
msgstr "Online"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Verbindung wird wiederhergestellt…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0} entfernen"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Gelöst"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Erneut versuchen"

#: src/panel/chat.ts
msgid "Save"
msgstr "Speichern"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "Geplant"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Gesehen"

#: src/panel/chat.ts
msgid "Send"
msgstr "Senden"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Schreiben Sie uns, wir antworten hier."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Wird gesendet…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Gesendet"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Ältere Unterhaltungen anzeigen"

