msgid "Could not send your rating. Try again."
msgstr "Ihre Bewertung konnte nicht gesendet werden. Versuchen Sie es erneut."

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "Schließen"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "E-Mail-Adresse"

