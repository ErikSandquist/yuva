#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Fast geschafft. Sehen Sie in Ihr Postfach und bestätigen Sie Ihr Abonnement."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Sehen Sie zur Bestätigung in Ihr Postfach."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Wählen Sie mindestens eine Liste."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Anmeldung fehlgeschlagen. Versuchen Sie es erneut."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-Mail-Adresse"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Geben Sie eine gültige E-Mail-Adresse ein."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Geben Sie Ihren Namen ein."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Ich möchte E-Mails von {inbox} zu {list} erhalten. Ich kann mich jederzeit abmelden."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listen"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Abonnieren"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Wird angemeldet…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Danke! Sie sind angemeldet."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Setzen Sie das Häkchen, um zuzustimmen."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Zu viele Versuche. Warten Sie einen Moment und versuchen Sie es erneut."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Sie scheinen offline zu sein."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Ihr Konto hat noch keine E-Mail-Adresse."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Ihr Name"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Ihr Name (optional)"
