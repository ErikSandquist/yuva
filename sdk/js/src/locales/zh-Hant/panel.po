msgstr "嘗試次數過多。請稍候片刻後再試一次。"

#: src/panel/chat.ts
msgid "Try again"
msgstr "重試"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "正在輸入…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "通常會在 {duration} 內回覆"

