msgid "Remove {0}"
msgstr "移除 {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "已解決"

#: src/panel/chat.ts
msgid "Retry"
msgstr "重試"

#: src/panel/chat.ts
msgid "Save"
msgstr "儲存"

#: src/panel/chat.ts
msgid "Seen"
msgstr "已讀"

#: src/panel/chat.ts
msgid "Send"
msgstr "傳送"

