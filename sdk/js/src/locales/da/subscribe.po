#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Næsten færdig. Tjek din indbakke, og bekræft dit abonnement."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Tjek din indbakke for at bekræfte."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Vælg mindst én liste."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Kunne ikke tilmelde. Prøv igen."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-mailadresse"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Indtast en gyldig e-mailadresse."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Indtast dit navn."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Jeg vil gerne modtage e-mails om {list} fra {inbox}. Jeg kan til enhver tid framelde mig."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Lister"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Privatlivspolitik"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Tilmeld"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Tilmelder…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Tak! Du er tilmeldt."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Sæt kryds for at acceptere."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "For mange forsøg. Vent et øjeblik, og prøv igen."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Du ser ud til at være offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Din konto har endnu ingen e-mailadresse."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Dit navn"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Dit navn (valgfrit)"
