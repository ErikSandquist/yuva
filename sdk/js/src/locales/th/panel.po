#: src/panel/chat.ts
msgid "Completed"
msgstr "เสร็จสิ้น"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "การสนทนา"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "ไม่สามารถบันทึกอีเมลของคุณได้ โปรดลองอีกครั้ง"

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "ไม่สามารถส่งคะแนนของคุณได้ โปรดลองอีกครั้ง"

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "ปิด"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "อีเมล"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "กรุณากรอกอีเมลที่ถูกต้อง"

#: src/panel/chat.ts
msgid "Good"
msgstr "ดี"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "เราทำได้ดีแค่ไหน"

#: src/panel/chat.ts
msgid "Identified"
msgstr "พบสาเหตุแล้ว"

#: src/panel/chat.ts
msgid "In progress"
msgstr "กำลังดำเนินการ"

#: src/panel/chat.ts
msgid "Investigating"
msgstr "กำลังตรวจสอบ"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "กำลังโหลด…"

#: src/panel/chat.ts
msgid "Message"
msgstr "ข้อความ"

#: src/panel/chat.ts
msgid "Messages"
msgstr "ข้อความ"

#: src/panel/chat.ts
msgid "Monitoring"
msgstr "กำลังเฝ้าติดตาม"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "การสนทนาใหม่"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "ยังไม่มีการสนทนา"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "ขณะนี้ไม่มีผู้ให้บริการ ฝากอีเมลของคุณไว้ แล้วเราจะส่งคำตอบไปที่นั่นด้วย"

#: src/panel/chat.ts
msgid "Not sent."
msgstr "ยังไม่ได้ส่ง"

#: src/panel/chat.ts
msgid "Online"
msgstr "ออนไลน์"

#: src/panel/chat.ts
msgid "Reconnecting…"
