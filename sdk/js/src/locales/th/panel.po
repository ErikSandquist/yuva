#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} กำลังพิมพ์…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "การสนทนาทั้งหมด"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "ต้องการเพิ่มเติมอะไรไหม (ไม่บังคับ)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "แนบไฟล์"

#: src/panel/chat.ts
