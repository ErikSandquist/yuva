#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "ลบ {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "แก้ไขแล้ว"

#: src/panel/chat.ts
msgid "Retry"
msgstr "ลองอีกครั้ง"

#: src/panel/chat.ts
msgid "Save"
msgstr "บันทึก"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "กำหนดไว้"

#: src/panel/chat.ts
msgid "Seen"
msgstr "อ่านแล้ว"

#: src/panel/chat.ts
msgid "Send"
msgstr "ส่ง"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "ส่งข้อความถึงเรา แล้วเราจะตอบที่นี่"

#: src/panel/chat.ts
msgid "Sending…"
msgstr "กำลังส่ง…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "ส่งแล้ว"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "แสดงการสนทนาที่เก่ากว่า"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "ลงชื่อเข้าใช้เพื่อแชตกับเรา"

#: src/panel/chat.ts
msgid "Skip"
msgstr "ข้าม"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "ขอบคุณสำหรับความคิดเห็นของคุณ"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "ขอบคุณ! หากคุณไม่อยู่ตอนที่เราตอบ เราจะส่งอีเมลไปที่ {known}"

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "ไฟล์มีขนาดใหญ่เกินไป"

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "ไม่รองรับไฟล์ประเภทนี้"

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "ลองหลายครั้งเกินไป โปรดรอสักครู่แล้วลองอีกครั้ง"

#: src/panel/chat.ts
msgid "Try again"
msgstr "ลองอีกครั้ง"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "กำลังพิมพ์…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "โดยปกติจะตอบภายใน {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "เราจะตอบกลับโดยเร็วที่สุด"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "ขณะนี้เราไม่อยู่"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "พิมพ์ข้อความ…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "ดูเหมือนว่าคุณออฟไลน์อยู่"

#: src/panel/chat.ts
msgid "You:"
msgstr "คุณ:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "การลงชื่อเข้าใช้ของคุณหมดอายุแล้ว โปรดโหลดหน้าใหม่แล้วลองอีกครั้ง"
