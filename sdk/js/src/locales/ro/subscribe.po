#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Aproape gata. Verifică-ți inboxul și confirmă abonarea."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Verifică-ți inboxul pentru a confirma."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Alege cel puțin o listă."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Abonarea nu a reușit. Încearcă din nou."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Adresa de e-mail"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Introdu o adresă de e-mail validă."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Introdu numele tău."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Vreau să primesc e-mailuri despre {list} de la {inbox}. Mă pot dezabona oricând."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Liste"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Politica de confidențialitate"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Abonează-te"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Se abonează…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Mulțumim! Ești abonat."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Bifează căsuța pentru a fi de acord."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Prea multe încercări. Așteaptă puțin și încearcă din nou."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Pari să fii offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Contul tău nu are încă o adresă de e-mail."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Numele tău"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Numele tău (opțional)"
