#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} друкує…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Усі розмови"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Хочете щось додати? (необов’язково)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Прикріпити файли"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Вкладення"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Погано"

#: src/panel/chat.ts
