msgstr "Чат зараз недоступний."

#: src/panel/chat.ts
msgid "Close"
msgstr "Закрити"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Коментар"

#: src/panel/chat.ts
msgid "Completed"
msgstr "Завершено"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Розмова"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Не вдалося зберегти вашу електронну адресу. Спробуйте ще раз."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Не вдалося надіслати вашу оцінку. Спробуйте ще раз."

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "Закрити"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "Електронна адреса"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Введіть дійсну електронну адресу."

#: src/panel/chat.ts
msgid "Good"
msgstr "Добре"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Як ми впоралися?"

#: src/panel/chat.ts
msgid "Identified"
msgstr "Причину виявлено"

#: src/panel/chat.ts
msgid "In progress"
msgstr "Триває"

#: src/panel/chat.ts
msgid "Investigating"
msgstr "Досліджуємо"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Завантаження…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Повідомлення"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Повідомлення"

