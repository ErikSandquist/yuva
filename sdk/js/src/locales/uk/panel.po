msgid "New conversation"
msgstr "Нова розмова"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Ще немає розмов"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Зараз нікого немає на зв’язку. Залиште свою електронну адресу, і ми надішлемо відповідь і туди."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Не надіслано."

#: src/panel/chat.ts
msgid "Online"
msgstr "Онлайн"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Повторне підключення…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Видалити {0}"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "Вирішено"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Повторити"

#: src/panel/chat.ts
msgid "Save"
msgstr "Зберегти"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "Заплановано"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Прочитано"

#: src/panel/chat.ts
msgid "Send"
msgstr "Надіслати"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Напишіть нам, і ми відповімо тут."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Надсилання…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Надіслано"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Показати старіші розмови"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Увійдіть, щоб поспілкуватися з нами."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Пропустити"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Дякуємо за відгук"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Дякуємо! Якщо вас не буде на місці, коли ми відповімо, ми напишемо на {known}."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Файл завеликий."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Цей тип файлу не приймається."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Забагато спроб. Зачекайте трохи й спробуйте ще раз."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Повторити"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Друкує…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Зазвичай відповідає за {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Ми відповімо якомога швидше"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Нас зараз немає"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Напишіть повідомлення…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Схоже, ви офлайн."

#: src/panel/chat.ts
msgid "You:"
msgstr "Ви:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Термін дії вашого входу минув. Оновіть сторінку й спробуйте ще раз."
