#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Hampir selesai. Periksa kotak masuk Anda dan konfirmasi langganan."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Periksa kotak masuk Anda untuk mengonfirmasi."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Pilih setidaknya satu daftar."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Tidak dapat berlangganan. Coba lagi."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Alamat e-mail"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Masukkan alamat e-mail yang valid."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Masukkan nama Anda."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Saya ingin menerima e-mail tentang {list} dari {inbox}. Saya dapat berhenti berlangganan kapan saja."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Daftar"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Kebijakan privasi"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Berlangganan"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Sedang berlangganan…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Terima kasih! Anda sudah berlangganan."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Centang kotak untuk menyetujui."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Terlalu banyak percobaan. Tunggu sebentar lalu coba lagi."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Anda tampaknya sedang offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Akun Anda belum memiliki alamat e-mail."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Nama Anda"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Nama Anda (opsional)"
