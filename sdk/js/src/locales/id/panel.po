#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} sedang mengetik…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Semua percakapan"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "Ada yang ingin Anda tambahkan? (opsional)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Lampirkan file"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Lampiran"

#: src/panel/chat.ts
msgid "Bad"
msgstr "Buruk"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "Obrolan tidak tersedia saat ini."

#: src/panel/chat.ts
msgid "Close"
msgstr "Tutup"

#: src/panel/chat.ts
msgid "Comment"
msgstr "Komentar"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Percakapan"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "Alamat e-mail Anda tidak dapat disimpan. Coba lagi."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "Penilaian Anda tidak dapat dikirim. Coba lagi."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "Alamat e-mail"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Masukkan alamat e-mail yang valid."

#: src/panel/chat.ts
msgid "Good"
msgstr "Baik"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "Bagaimana pelayanan kami?"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Memuat…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Pesan"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Pesan"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Percakapan baru"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Belum ada percakapan"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Saat ini tidak ada yang tersedia. Tinggalkan e-mail Anda dan kami akan mengirim balasan ke sana juga."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Tidak terkirim."

#: src/panel/chat.ts
msgid "Online"
msgstr "Online"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Menyambung kembali…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "Hapus {0}"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Coba lagi"

#: src/panel/chat.ts
msgid "Save"
msgstr "Simpan"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Dilihat"

#: src/panel/chat.ts
msgid "Send"
msgstr "Kirim"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Kirim pesan kepada kami dan kami akan membalas di sini."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Mengirim…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Terkirim"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Tampilkan percakapan lama"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Masuk untuk mengobrol dengan kami."

#: src/panel/chat.ts
msgid "Skip"
msgstr "Lewati"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "Terima kasih atas masukan Anda"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Terima kasih! Kami akan mengirim e-mail ke {known} jika Anda tidak ada saat kami membalas."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "File terlalu besar."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Jenis file ini tidak diterima."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Terlalu banyak percobaan. Tunggu sebentar lalu coba lagi."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Coba lagi"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Sedang mengetik…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Biasanya membalas dalam {duration}"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "Kami akan membalas secepatnya"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Kami sedang tidak ada"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Tulis pesan…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Anda tampaknya sedang offline."

#: src/panel/chat.ts
msgid "You:"
msgstr "Anda:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Sesi masuk Anda telah berakhir. Muat ulang halaman lalu coba lagi."
