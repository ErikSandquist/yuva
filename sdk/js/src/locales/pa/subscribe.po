#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "ਲਗਭਗ ਹੋ ਗਿਆ। ਆਪਣਾ ਇਨਬਾਕਸ ਦੇਖੋ ਅਤੇ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਦੀ ਪੁਸ਼ਟੀ ਕਰੋ।"

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "ਪੁਸ਼ਟੀ ਲਈ ਆਪਣਾ ਇਨਬਾਕਸ ਦੇਖੋ।"

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "ਘੱਟੋ-ਘੱਟ ਇੱਕ ਸੂਚੀ ਚੁਣੋ।"

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "ਸਬਸਕ੍ਰਾਈਬ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "ਈਮੇਲ ਪਤਾ"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "ਇੱਕ ਸਹੀ ਈਮੇਲ ਪਤਾ ਦਰਜ ਕਰੋ।"

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "ਆਪਣਾ ਨਾਮ ਦਰਜ ਕਰੋ।"

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "ਮੈਂ {inbox} ਤੋਂ {list} ਬਾਰੇ ਈਮੇਲਾਂ ਪ੍ਰਾਪਤ ਕਰਨਾ ਚਾਹੁੰਦਾ ਹਾਂ। ਮੈਂ ਕਿਸੇ ਵੀ ਸਮੇਂ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਰੱਦ ਕਰ ਸਕਦਾ ਹਾਂ।"

#: src/subscribe/element.ts
msgid "Lists"
msgstr "ਸੂਚੀਆਂ"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "ਪਰਦੇਦਾਰੀ ਨੀਤੀ"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "ਸਬਸਕ੍ਰਾਈਬ ਕਰੋ"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "ਸਬਸਕ੍ਰਾਈਬ ਹੋ ਰਿਹਾ ਹੈ…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "ਧੰਨਵਾਦ! ਤੁਸੀਂ ਸਬਸਕ੍ਰਾਈਬ ਕਰ ਲਿਆ ਹੈ।"

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "ਸਹਿਮਤ ਹੋਣ ਲਈ ਡੱਬੇ ’ਤੇ ਟਿਕ ਕਰੋ।"

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "ਬਹੁਤ ਵਾਰ ਕੋਸ਼ਿਸ਼ ਹੋ ਗਈ। ਥੋੜ੍ਹਾ ਰੁਕੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "ਲੱਗਦਾ ਹੈ ਤੁਸੀਂ ਆਫ਼ਲਾਈਨ ਹੋ।"

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "ਤੁਹਾਡੇ ਖਾਤੇ ਵਿੱਚ ਅਜੇ ਕੋਈ ਈਮੇਲ ਪਤਾ ਨਹੀਂ ਹੈ।"

#: src/subscribe/element.ts
msgid "Your name"
msgstr "ਤੁਹਾਡਾ ਨਾਮ"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "ਤੁਹਾਡਾ ਨਾਮ (ਵਿਕਲਪਿਕ)"
