#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Hampir siap. Semak peti masuk anda dan sahkan langganan anda."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Semak peti masuk anda untuk mengesahkan."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Pilih sekurang-kurangnya satu senarai."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Tidak dapat melanggan. Cuba lagi."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "Alamat e-mel"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Masukkan alamat e-mel yang sah."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Masukkan nama anda."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Saya mahu menerima e-mel tentang {list} daripada {inbox}. Saya boleh berhenti melanggan pada bila-bila masa."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Senarai"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Dasar privasi"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Langgan"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Melanggan…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Terima kasih! Anda telah melanggan."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Tandakan kotak untuk bersetuju."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Terlalu banyak percubaan. Tunggu sebentar dan cuba lagi."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Anda kelihatan di luar talian."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Akaun anda belum mempunyai alamat e-mel."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Nama anda"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Nama anda (pilihan)"
