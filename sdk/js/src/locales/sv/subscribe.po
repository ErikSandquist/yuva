#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Nästan klart. Kolla din inkorg och bekräfta din prenumeration."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Kolla din inkorg för att bekräfta."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "Välj minst en lista."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Det gick inte att prenumerera. Försök igen."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-postadress"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Ange en giltig e-postadress."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Ange ditt namn."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "Jag vill ta emot e-post om {list} från {inbox}. Jag kan avsluta prenumerationen när som helst."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listor"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Integritetspolicy"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Prenumerera"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Prenumererar…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Tack! Du prenumererar nu."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Bocka i rutan för att godkänna."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "För många försök. Vänta en stund och försök igen."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Du verkar vara offline."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Ditt konto har ingen e-postadress än."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Ditt namn"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Ditt namn (valfritt)"
