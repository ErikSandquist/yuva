#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "تقریباً مکمل۔ اپنا ان باکس چیک کریں اور سبسکرپشن کی تصدیق کریں۔"

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "تصدیق کے لیے اپنا ان باکس چیک کریں۔"

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "کم از کم ایک فہرست منتخب کریں۔"

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "سبسکرائب نہیں ہو سکا۔ دوبارہ کوشش کریں۔"

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "ای میل پتہ"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "درست ای میل پتہ درج کریں۔"

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "اپنا نام درج کریں۔"

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "میں {inbox} کی طرف سے {list} کے بارے میں ای میلز حاصل کرنا چاہتا ہوں۔ میں کسی بھی وقت سبسکرپشن ختم کر سکتا ہوں۔"

#: src/subscribe/element.ts
msgid "Lists"
msgstr "فہرستیں"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "رازداری کی پالیسی"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "سبسکرائب کریں"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "سبسکرائب ہو رہا ہے…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "شکریہ! آپ سبسکرائب ہو گئے ہیں۔"

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "اتفاق کرنے کے لیے خانے پر نشان لگائیں۔"

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "بہت زیادہ کوششیں ہو گئیں۔ ذرا انتظار کریں اور دوبارہ کوشش کریں۔"

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "لگتا ہے آپ آف لائن ہیں۔"

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "آپ کے اکاؤنٹ میں ابھی تک ای میل پتہ نہیں ہے۔"

#: src/subscribe/element.ts
msgid "Your name"
msgstr "آپ کا نام"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "آپ کا نام (اختیاری)"
