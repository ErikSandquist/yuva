#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "Neredeyse bitti. Gelen kutunuza bakın ve aboneliğinizi onaylayın."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "Onaylamak için gelen kutunuza bakın."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "En az bir liste seçin."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "Abone olunamadı. Yeniden deneyin."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "E-posta adresi"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "Geçerli bir e-posta adresi girin."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "Adınızı girin."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "{list} hakkında {inbox} tarafından gönderilen e-postaları almak istiyorum. Aboneliğimi istediğim zaman bırakabilirim."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "Listeler"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "Gizlilik politikası"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "Abone ol"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "Abone olunuyor…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "Teşekkürler! Abone oldunuz."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "Onaylamak için kutuyu işaretleyin."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Çok fazla deneme. Biraz bekleyip tekrar deneyin."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "Çevrimdışı görünüyorsunuz."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "Hesabınızda henüz bir e-posta adresi yok."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "Adınız"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "Adınız (isteğe bağlı)"
