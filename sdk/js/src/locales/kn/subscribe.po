#: src/subscribe/element.ts
msgid "Almost done. Check your inbox and confirm your subscription."
msgstr "ಬಹುತೇಕ ಮುಗಿಯಿತು. ನಿಮ್ಮ ಇನ್‌ಬಾಕ್ಸ್ ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಚಂದಾದಾರಿಕೆಯನ್ನು ಖಚಿತಪಡಿಸಿ."

#: src/subscribe/element.ts
msgid "Check your inbox to confirm."
msgstr "ಖಚಿತಪಡಿಸಲು ನಿಮ್ಮ ಇನ್‌ಬಾಕ್ಸ್ ಪರಿಶೀಲಿಸಿ."

#: src/subscribe/element.ts
msgid "Choose at least one list."
msgstr "ಕನಿಷ್ಠ ಒಂದು ಪಟ್ಟಿಯನ್ನು ಆರಿಸಿ."

#: src/subscribe/element.ts
msgid "Could not subscribe. Try again."
msgstr "ಚಂದಾದಾರರಾಗಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/subscribe/element.ts
msgid "E-mail address"
msgstr "ಇಮೇಲ್ ವಿಳಾಸ"

#: src/subscribe/element.ts
msgid "Enter a valid e-mail address."
msgstr "ಮಾನ್ಯವಾದ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ನಮೂದಿಸಿ."

#: src/subscribe/element.ts
msgid "Enter your name."
msgstr "ನಿಮ್ಮ ಹೆಸರನ್ನು ನಮೂದಿಸಿ."

#: src/subscribe/element.ts
msgid "I want to receive e-mails about {list} from {inbox}. I can unsubscribe at any time."
msgstr "{inbox} ನಿಂದ {list} ಬಗ್ಗೆ ಇಮೇಲ್‌ಗಳನ್ನು ಪಡೆಯಲು ನಾನು ಬಯಸುತ್ತೇನೆ. ನಾನು ಯಾವಾಗ ಬೇಕಾದರೂ ಚಂದಾದಾರಿಕೆ ರದ್ದುಮಾಡಬಹುದು."

#: src/subscribe/element.ts
msgid "Lists"
msgstr "ಪಟ್ಟಿಗಳು"

#: src/subscribe/element.ts
msgid "Privacy policy"
msgstr "ಗೌಪ್ಯತಾ ನೀತಿ"

#: src/subscribe/element.ts
msgid "Subscribe"
msgstr "ಚಂದಾದಾರರಾಗಿ"

#: src/subscribe/element.ts
msgid "Subscribing…"
msgstr "ಚಂದಾದಾರರಾಗಲಾಗುತ್ತಿದೆ…"

#: src/subscribe/element.ts
msgid "Thanks! You are subscribed."
msgstr "ಧನ್ಯವಾದಗಳು! ನೀವು ಚಂದಾದಾರರಾಗಿದ್ದೀರಿ."

#: src/subscribe/element.ts
msgid "Tick the box to agree."
msgstr "ಒಪ್ಪಲು ಬಾಕ್ಸ್ ಟಿಕ್ ಮಾಡಿ."

#: src/subscribe/element.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "ತುಂಬಾ ಪ್ರಯತ್ನಗಳು. ಸ್ವಲ್ಪ ಕಾಯಿರಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/subscribe/element.ts
msgid "You seem to be offline."
msgstr "ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿರುವಂತೆ ತೋರುತ್ತಿದೆ."

#: src/subscribe/element.ts
msgid "Your account has no e-mail address yet."
msgstr "ನಿಮ್ಮ ಖಾತೆಗೆ ಇನ್ನೂ ಇಮೇಲ್ ವಿಳಾಸವಿಲ್ಲ."

#: src/subscribe/element.ts
msgid "Your name"
msgstr "ನಿಮ್ಮ ಹೆಸರು"

#: src/subscribe/element.ts
msgid "Your name (optional)"
msgstr "ನಿಮ್ಮ ಹೆಸರು (ಐಚ್ಛಿಕ)"
