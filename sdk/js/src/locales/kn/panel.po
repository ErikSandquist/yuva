#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} ಟೈಪ್ ಮಾಡುತ್ತಿದ್ದಾರೆ…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "ಎಲ್ಲಾ ಸಂಭಾಷಣೆಗಳು"

#: src/panel/chat.ts
msgid "Anything you'd like to add? (optional)"
msgstr "ಏನಾದರೂ ಸೇರಿಸಲು ಬಯಸುವಿರಾ? (ಐಚ್ಛಿಕ)"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "ಫೈಲ್‌ಗಳನ್ನು ಲಗತ್ತಿಸಿ"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "ಲಗತ್ತು"

#: src/panel/chat.ts
msgid "Bad"
msgstr "ಕೆಟ್ಟದು"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "ಚಾಟ್ ಈಗ ಲಭ್ಯವಿಲ್ಲ."

#: src/panel/chat.ts
msgid "Close"
msgstr "ಮುಚ್ಚಿ"

#: src/panel/chat.ts
msgid "Comment"
msgstr "ಕಾಮೆಂಟ್"

#: src/panel/chat.ts
msgid "Completed"
msgstr "ಪೂರ್ಣಗೊಂಡಿದೆ"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "ಸಂಭಾಷಣೆ"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "ನಿಮ್ಮ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಉಳಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/panel/chat.ts
msgid "Could not send your rating. Try again."
msgstr "ನಿಮ್ಮ ರೇಟಿಂಗ್ ಕಳುಹಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/panel/chat.ts
msgid "Dismiss"
msgstr "ವಜಾಗೊಳಿಸಿ"

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "ಇಮೇಲ್ ವಿಳಾಸ"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "ಮಾನ್ಯವಾದ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ನಮೂದಿಸಿ."

#: src/panel/chat.ts
msgid "Good"
msgstr "ಒಳ್ಳೆಯದು"

#: src/panel/chat.ts
msgid "How did we do?"
msgstr "ನಾವು ಹೇಗೆ ಮಾಡಿದೆವು?"

#: src/panel/chat.ts
msgid "Identified"
msgstr "ಕಾರಣ ಗುರುತಿಸಲಾಗಿದೆ"

#: src/panel/chat.ts
msgid "In progress"
msgstr "ಪ್ರಗತಿಯಲ್ಲಿದೆ"

#: src/panel/chat.ts
msgid "Investigating"
msgstr "ಪರಿಶೀಲನೆಯಲ್ಲಿದೆ"

#: src/panel/chat.ts
msgid "Loading…"
msgstr "ಲೋಡ್ ಆಗುತ್ತಿದೆ…"

#: src/panel/chat.ts
msgid "Message"
msgstr "ಸಂದೇಶ"

#: src/panel/chat.ts
msgid "Messages"
msgstr "ಸಂದೇಶಗಳು"

#: src/panel/chat.ts
msgid "Monitoring"
msgstr "ನಿಗಾದಲ್ಲಿದೆ"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "ಹೊಸ ಸಂಭಾಷಣೆ"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "ಇನ್ನೂ ಯಾವುದೇ ಸಂಭಾಷಣೆಗಳಿಲ್ಲ"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "ಈಗ ಯಾರೂ ಲಭ್ಯರಿಲ್ಲ. ನಿಮ್ಮ ಇಮೇಲ್ ಬಿಡಿ, ಉತ್ತರವನ್ನು ಅಲ್ಲಿಗೂ ಕಳುಹಿಸುತ್ತೇವೆ."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "ಕಳುಹಿಸಲಾಗಿಲ್ಲ."

#: src/panel/chat.ts
msgid "Online"
msgstr "ಆನ್‌ಲೈನ್"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "ಮರುಸಂಪರ್ಕಿಸಲಾಗುತ್ತಿದೆ…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0} ತೆಗೆದುಹಾಕಿ"

#: src/panel/chat.ts
msgid "Resolved"
msgstr "ಪರಿಹರಿಸಲಾಗಿದೆ"

#: src/panel/chat.ts
msgid "Retry"
msgstr "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"

#: src/panel/chat.ts
msgid "Save"
msgstr "ಉಳಿಸಿ"

#: src/panel/chat.ts
msgid "Scheduled"
msgstr "ನಿಗದಿಯಾಗಿದೆ"

#: src/panel/chat.ts
msgid "Seen"
msgstr "ನೋಡಲಾಗಿದೆ"

#: src/panel/chat.ts
msgid "Send"
msgstr "ಕಳುಹಿಸಿ"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "ನಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ, ನಾವು ಇಲ್ಲಿಯೇ ಉತ್ತರಿಸುತ್ತೇವೆ."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "ಕಳುಹಿಸಲಾಗುತ್ತಿದೆ…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "ಕಳುಹಿಸಲಾಗಿದೆ"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "ಹಳೆಯ ಸಂಭಾಷಣೆಗಳನ್ನು ತೋರಿಸಿ"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "ನಮ್ಮೊಂದಿಗೆ ಚಾಟ್ ಮಾಡಲು ಸೈನ್ ಇನ್ ಮಾಡಿ."

#: src/panel/chat.ts
msgid "Skip"
msgstr "ಬಿಟ್ಟುಬಿಡಿ"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "ನಿಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆಗೆ ಧನ್ಯವಾದಗಳು"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "ಧನ್ಯವಾದಗಳು! ನಾವು ಉತ್ತರಿಸುವಾಗ ನೀವು ಇಲ್ಲದಿದ್ದರೆ {known} ಗೆ ಇಮೇಲ್ ಮಾಡುತ್ತೇವೆ."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "ಫೈಲ್ ತುಂಬಾ ದೊಡ್ಡದಾಗಿದೆ."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "ಈ ರೀತಿಯ ಫೈಲ್ ಸ್ವೀಕರಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "ತುಂಬಾ ಪ್ರಯತ್ನಗಳು. ಸ್ವಲ್ಪ ಕಾಯಿರಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/panel/chat.ts
msgid "Try again"
msgstr "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "ಟೈಪ್ ಮಾಡುತ್ತಿದ್ದಾರೆ…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "ಸಾಮಾನ್ಯವಾಗಿ {duration} ಒಳಗೆ ಉತ್ತರಿಸುತ್ತಾರೆ"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "ನಾವು ಸಾಧ್ಯವಾದಷ್ಟು ಬೇಗ ಉತ್ತರಿಸುತ್ತೇವೆ"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "ನಾವು ಈಗ ಇಲ್ಲಿಲ್ಲ"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "ಸಂದೇಶ ಬರೆಯಿರಿ…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿರುವಂತೆ ತೋರುತ್ತಿದೆ."

#: src/panel/chat.ts
msgid "You:"
msgstr "ನೀವು:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "ನಿಮ್ಮ ಸೈನ್-ಇನ್ ಅವಧಿ ಮುಗಿದಿದೆ. ಪುಟವನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
