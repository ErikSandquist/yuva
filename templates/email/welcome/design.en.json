    {
      "id": "start",
      "type": "button",
      "label": "Get started",
      "url": "https://example.com/start",
      "padding": [
        24,
        32,
        16,
        32
      ]
    },
    {
      "id": "reply",
      "type": "section",
      "background": "#fbf1e6",
      "border_radius": 0,
      "padding": [
        16,
        0,
        16,
        0
