              "id": "s3-text",
              "type": "text",
              "html": "<p>Drivers get them on their phones, customers get a delivery window.</p>",
              "size": 15,
              "padding": [
                0,
                0,
                0,
                0
              ]
            }
          ]
        }
      ]
