{
  "schema": 1,
  "theme": {
    "width": 600,
    "direction": "auto",
    "font": "system",
    "radius": 12,
    "colors": {
      "page": "#fbf3ea",
      "card": "#ffffff",
      "text": "#1c1917",
      "muted": "#57534e",
      "accent": "#c2410c",
      "link": "#c2410c",
      "border": "#f0e2d3"
    }
  },
  "preheader": "Three short steps to your first delivery, and a person on the other end of this e-mail.",
