{
  "name": "yuva-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run registry && astro dev --host 127.0.0.1 --port 4321",
    "build": "bun run registry && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "i18n": "lingui extract --clean && lingui compile --strict && bun scripts/i18n-check.ts",
    "links": "bun scripts/check-links.ts",
    "check": "bun run format:check && bun run lint && bun run i18n && bun run build && bun run links",
    "lint": "oxlint",
    "format": "oxfmt && prettier --write --log-level warn \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check --log-level warn \"src/**/*.astro\"",
    "registry": "bun scripts/registry.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lingui/core": "6.9.0",
    "@scalar/api-reference": "1.73.1",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "1.55.0",
    "marked": "^18.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "useyuva": "0.0.26",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/compiler": "2.13.1",
    "@babel/core": "^8.0.6",
    "@lingui/babel-plugin-lingui-macro": "6.9.0",
    "@lingui/cli": "6.9.0",
    "@lingui/conf": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@messageformat/parser": "5.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "geist": "^1.7.2",
    "opentype.js": "2.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "shadcn": "4.21.4",
    "simple-icons": "16.35.0",
    "typescript": "~6"
  }
}
