---
import type { HomeCopy } from "@/copy/home"
import StartCards from "@/ui/StartCards.astro"
import Stop from "@/ui/Stop.astro"

interface Props {
  t: HomeCopy["close"]
  hero: HomeCopy["hero"]
}

const { t, hero } = Astro.props
---

<Stop labelledby="close-title">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
    <div>
      <h2 id="close-title" class="text-[clamp(2rem,1.4rem+2vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
        {t.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.lead}</p>
    </div>
    <StartCards t={hero} />
  </div>
</Stop>
