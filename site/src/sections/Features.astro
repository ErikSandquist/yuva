---
import type { HomeCopy } from "@/copy/home"
import type { StatusSampleCopy } from "@/copy/status"
import type { Shots } from "@/lib/shots"
import SectionHead from "@/ui/SectionHead.astro"
import Shot from "@/ui/Shot.astro"
import StatusSample from "@/ui/StatusSample.astro"
import Stop from "@/ui/Stop.astro"

interface Props {
  t: HomeCopy["features"]
  shots: Shots
  previews: { name: string; src: string; href: string }[]
  status: StatusSampleCopy
}

const { t, shots: s, previews, status } = Astro.props
const row = "grid items-center gap-10 lg:gap-16"
const link = "mt-6 inline-flex text-sm font-medium text-brand hover:underline"
const apps = [
  { name: "iOS", shots: s.ios },
  { name: "Android", shots: s.android },
]
---

{t.items.map((f, i) => {
  const flip = i % 2 === 1
  const alt = f.shot ? t.alts[f.shot] : ""
  return (
    <Stop
      id={f.id}
      labelledby={`${f.id}-title`}
      tone={flip ? "deep" : "paper"}
      index={String(i + 1).padStart(2, "0")}
      label={f.title}
    >
      <div class:list={[row, (f.shot || f.visual) && "lg:grid-cols-2"]}>
        <div class:list={["min-w-0", (f.shot || f.visual) && flip && "lg:order-2"]}>
          <SectionHead title={f.title} lead={f.body} id={`${f.id}-title`} />
          {f.shot || f.visual ? (
            <ul class="mt-8 grid max-w-xl gap-3 text-sm">
              {f.points.map((p) => (
                <li class="flex gap-3 border-t border-rule pt-3">
                  <span class="w-2/5 shrink-0 font-semibold tracking-tight">{p.term}</span>
                  <span class="text-ink-soft">{p.text}</span>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="mt-10 grid border-t border-rule sm:grid-cols-3">
              {f.points.map((p) => (
                <li class="border-b border-rule py-4 text-sm sm:border-b-0 sm:border-s sm:px-6 sm:first:border-s-0 sm:first:ps-0 sm:last:pe-0">
                  <span class="block font-semibold tracking-tight">{p.term}</span>
                  <span class="mt-1 block text-ink-soft">{p.text}</span>
                </li>
              ))}
            </ul>
          )}
          <a class={link} href={f.href}>
            {f.link ?? t.guide} →
          </a>
        </div>
        {f.visual === "status" && (
          <div class="min-w-0">
            <StatusSample t={status} compact />
          </div>
        )}
        {f.shot === "phone" && (
          <div class="mx-auto w-[min(17rem,72vw)] overflow-hidden rounded-[2.4rem] border-[7px] border-zinc-900 dark:border-zinc-700 [&_img]:aspect-[390/760] [&_img]:object-cover [&_img]:object-top">
            <Shot light={s.phone.light} dark={s.phone.dark} alt={alt} widths={[320, 480, 720]} sizes="272px" />
          </div>
        )}
        {f.shot === "widget" && (
          <div class="overflow-hidden rounded-lg border border-rule">
            <Shot
              light={s.widget.light}
              dark={s.widget.dark}
              alt={alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 520px, calc(100vw - 40px)"
            />
          </div>
        )}
        {f.shot && f.shot !== "phone" && f.shot !== "widget" && (
          <div class="overflow-hidden rounded-lg border border-rule">
            <Shot
              light={s[f.shot].light}
              dark={s[f.shot].dark}
              alt={alt}
              widths={[480, 720, 960, 1440]}
              sizes="(min-width: 1024px) 520px, calc(100vw - 40px)"
            />
          </div>
        )}
      </div>
      {f.id === "channels" && (
        <div class="mt-12 grid gap-10 sm:grid-cols-2 sm:gap-6 lg:gap-12">
          {apps.map((app) => (
            <figure class="min-w-0">
              <figcaption class="mb-4 flex items-center gap-3 text-sm font-medium tracking-tight text-ink-soft after:h-px after:flex-1 after:bg-rule">
                {app.name}
              </figcaption>
              <div class="grid grid-cols-2 items-start gap-3 sm:gap-4">
                {(["list", "thread"] as const).map((view) => (
                  <div class="overflow-hidden rounded-[1.25rem] border border-rule bg-paper lg:rounded-[1.75rem]">
                    <Shot
                      light={app.shots[view].light}
                      dark={app.shots[view].dark}
                      alt={t.appAlts[view](app.name)}
                      widths={[240, 360, 480, 720]}
                      sizes="(min-width: 1024px) 240px, (min-width: 640px) 22vw, calc(50vw - 22px)"
                    />
                  </div>
                ))}
              </div>
            </figure>
          ))}
        </div>
      )}
      {f.id === "designs" && (
        <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
          {previews.map((p, n) => (
            <li class:list={["min-w-0", n === 2 && "max-sm:hidden"]}>
              <a class="group block" href={p.href}>
                <span class="block aspect-[4/5] overflow-hidden border border-rule bg-paper-deep transition-colors group-hover:border-rule-strong">
                  <img
                    class="size-full object-cover object-top"
                    src={p.src}
                    alt={t.templateAlt(p.name)}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="mt-2 block text-sm font-medium group-hover:text-brand">{p.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </Stop>
  )
})}

<Stop
  labelledby="resources-title"
  tone={t.items.length % 2 ? "deep" : "paper"}
  index={String(t.items.length + 1).padStart(2, "0")}
  label={t.resources.title}
  headed
>
  <ul class="flex flex-wrap gap-x-8 gap-y-3 font-medium">
    {t.resources.links.map((l) => (
      <li>
        <a class="text-brand hover:underline" href={l.href}>
          {l.label} →
        </a>
      </li>
    ))}
  </ul>
</Stop>
