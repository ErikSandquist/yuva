---
import type { HomeCopy } from "@/copy/home"
import { APP_URL, links } from "@/lib/routes"
import { stack } from "@/lib/stack"
import type { Locale } from "@/lib/routes"
import type { Shots } from "@/lib/shots"
import GitHubIcon from "@/ui/GitHubIcon.astro"
import Lucide from "@/ui/Lucide.astro"
import Shot from "@/ui/Shot.astro"

interface Props {
  t: HomeCopy["hero"]
  shots: Shots
  locale: Locale
  alts: HomeCopy["features"]["alts"]
}

const { t, shots: s, alts, locale } = Astro.props
const panels = [
  { id: "widget", shot: s.widget, alt: alts.widget },
  { id: "feedback", shot: s.feedback, alt: t.feedbackAlt },
  { id: "broadcast", shot: s.broadcast, alt: alts.broadcast },
  { id: "analytics", shot: s.analytics, alt: alts.analytics },
  { id: "migration", shot: s.migration, alt: alts.migration },
] as const
const button =
  "inline-flex h-10 items-center gap-2 rounded-full px-5 text-sm font-medium transition-colors sm:h-11 sm:text-[0.95rem]"
---

<section aria-labelledby="hero-title">
  <div class="px-5 pt-10 pb-14 sm:px-8 sm:pt-16 sm:pb-20">
    <div class="mx-auto max-w-2xl text-center">
      <h1 id="hero-title" class="text-3xl leading-[1.1] font-semibold tracking-[-0.025em] text-balance sm:text-4xl">
        {t.title}
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft">{t.lead}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
        <a class:list={[button, "bg-signal text-white hover:bg-signal/90"]} href={`${APP_URL}/?signup=1`}>
          {t.signUp}
        </a>
        <a class:list={[button, "border border-rule-strong hover:border-ink/40 hover:bg-paper-deep"]} href={links.repo}>
          <GitHubIcon />
          {t.github}
        </a>
        <a
          class:list={[button, "border border-rule-strong hover:border-ink/40 hover:bg-paper-deep"]}
          href={t.startWithAiHref}
        >
          <Lucide name="sparkles" class="text-brand" />
          {t.startWithAi}
        </a>
      </div>
    </div>
    <div class="mx-auto mt-10 max-w-5xl sm:mt-14" data-tabs>
      <div
        class="flex overflow-x-auto border border-b-0 border-rule bg-paper-deep"
        role="tablist"
        aria-label={t.tourLabel}
      >
        {t.tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="relative h-11 shrink-0 cursor-pointer border-e border-rule px-4 text-sm whitespace-nowrap text-ink-soft transition-colors last:border-e-0 hover:text-ink aria-selected:bg-paper aria-selected:font-medium aria-selected:text-ink aria-selected:after:absolute aria-selected:after:inset-x-0 aria-selected:after:bottom-0 aria-selected:after:h-0.5 aria-selected:after:bg-brand"
          >
            {tab.label}
          </button>
        ))}
      </div>
      <div class="border border-rule">
        <div
          role="tabpanel"
          id="panel-inbox"
          aria-labelledby="tab-inbox"
          tabindex="0"
          class="max-sm:mx-auto max-sm:max-w-[316px]"
        >
          <Shot
            light={s.thread.light}
            dark={s.thread.dark}
            alt={t.shotAlt}
            widths={[720, 1080, 1440, 2160]}
            sizes="(min-width: 1080px) 1024px, calc(100vw - 48px)"
            small={{ light: s.phoneThread.light, dark: s.phoneThread.dark, widths: [390, 585, 780], sizes: "300px" }}
            eager
          />
        </div>
        {panels.map((p) => (
          <div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} tabindex="0" hidden>
            <Shot
              light={p.shot.light}
              dark={p.shot.dark}
              alt={p.alt}
              widths={[720, 1080, 1440, 2160]}
              sizes="(min-width: 1080px) 1024px, calc(100vw - 48px)"
            />
          </div>
        ))}
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3 border border-t-0 border-rule px-4 py-4">
        <p class="text-xs font-medium tracking-wide text-ink-faint uppercase">{t.worksWith}</p>
        <ul class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
          {stack.map((item) => (
            <li>
              <a
                href={item.href[locale]}
                class="inline-flex h-7 items-center gap-1.5 rounded-full border border-rule px-2.5 text-xs text-ink-soft transition-colors hover:border-rule-strong hover:text-ink sm:h-8 sm:text-[0.8rem]"
              >
                {item.path && (
                  <svg viewBox={item.viewBox ?? "0 0 24 24"} class="size-3.5 shrink-0 fill-current" aria-hidden="true">
                    <path d={item.path} fill-rule={item.viewBox ? "evenodd" : undefined} />
                  </svg>
                )}
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute("aria-selected", String(on))
        t.tabIndex = on ? 0 : -1
        root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on
      }
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab))
      tab.addEventListener("keydown", (e) => {
        const key = e.key
        const next =
          key === "ArrowRight"
            ? i + 1
            : key === "ArrowLeft"
              ? i - 1
              : key === "Home"
                ? 0
                : key === "End"
                  ? tabs.length - 1
                  : -1
        if (next < 0) return
        e.preventDefault()
        const target = tabs[(next + tabs.length) % tabs.length]!
        select(target)
        target.focus()
      })
    })
  })
</script>
