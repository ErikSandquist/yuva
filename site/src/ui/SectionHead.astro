---
interface Props {
  title: string
  lead?: string
  id: string
  center?: boolean
}

const { title, lead, id, center = false } = Astro.props
---

<header class:list={["max-w-2xl", center && "mx-auto text-center"]}>
  <h2 id={id} class="text-[clamp(2rem,1.4rem+2vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
    {title}
  </h2>
  {lead && <p class="mt-5 text-lg leading-relaxed text-pretty text-ink-soft">{lead}</p>}
  <slot />
</header>
