---
import type { StatusCopy } from "@/copy/status"

interface Props {
  t: StatusCopy["apps"]["widget"]
}

const { t } = Astro.props
---

<div
  class="mx-auto flex w-full max-w-sm flex-col overflow-hidden rounded-[1.25rem] border border-rule bg-paper shadow-paper"
  role="img"
  aria-label={t.alt}
>
  <div aria-hidden="true" class="flex flex-col">
    <div class="px-5 pt-5 pb-4">
      <p class="text-xl font-semibold">{t.title}</p>
    </div>
    <div class="mx-3 flex items-start gap-3 rounded-xl bg-amber-50 py-3 ps-3.5 pe-2 text-zinc-900 dark:bg-amber-950/50 dark:text-zinc-100">
      <span class="mt-2 size-2 shrink-0 rounded-full bg-amber-500"></span>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold">{t.line}</p>
        <p class="mt-0.5 text-[0.8rem] text-zinc-600 dark:text-zinc-400">
          {t.minor} · {t.investigating} · <span class="text-brand">{t.details}</span>
        </p>
      </div>
      <span class="grid size-8 shrink-0 place-items-center text-zinc-500" title={t.dismiss}>
        <svg
          viewBox="0 0 16 16"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M4 4l8 8M12 4l-8 8"></path>
        </svg>
      </span>
    </div>
    <div class="h-24"></div>
    <div class="px-5 pb-5">
      <span class="flex h-11 items-center justify-center rounded-full bg-signal text-[0.95rem] font-medium text-white">
        {t.send}
      </span>
    </div>
  </div>
</div>
