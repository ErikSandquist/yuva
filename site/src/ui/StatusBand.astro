---
import Cross from "@/ui/Cross.astro"
import StatusBars from "@/ui/StatusBars.astro"
import type { StatusCopy } from "@/copy/status"
import type { BarTone } from "@/lib/statusBars"

interface Props {
  t: StatusCopy
  dark?: boolean
  label: string
}

const { t, dark = false, label } = Astro.props
const night =
  "[--ink:#fafafa] [--ink-soft:#a1a1aa] [--ink-faint:#8a8a93] [--rule:#27272a] [--paper:#09090b] text-ink bg-paper"
const marks: Record<number, BarTone> = { 14: "warn", 15: "warn", 37: "maint", 58: "partial", 71: "warn", 89: "warn" }
const rows = [
  { name: "API", state: t.sample.degraded, tone: "warn", text: "text-(--st-warn-text)" },
  { name: t.sample.website, state: t.sample.ok, tone: "ok", text: "text-ink-soft" },
  { name: t.sample.email, state: t.sample.ok, tone: "ok", text: "text-ink-soft" },
  { name: t.sample.chat, state: t.sample.ok, tone: "ok", text: "text-ink-soft" },
]
---

<figure class:list={["m-0", dark ? "status-palette-dark" : "status-palette"]}>
  <figcaption class="mb-3 font-mono text-[0.7rem] tracking-widest text-ink-soft uppercase">{label}</figcaption>
  <div
    class:list={["overflow-hidden border border-rule", dark ? night : "bg-paper text-ink"]}
    role="img"
    aria-label={t.band.alt}
  >
    <div aria-hidden="true">
      <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-5 sm:px-8">
        <span class="text-lg font-bold tracking-tight">Acme</span>
        <span class="flex gap-5 text-sm text-ink-soft">
          <span>{t.band.pricing}</span>
          <span>{t.band.docs}</span>
          <span>{t.band.privacy}</span>
        </span>
      </div>
      <div class="border-t border-rule px-5 sm:px-8">
        <div class="relative mb-6 border border-t-0 border-rule">
          <Cross class="-start-[6px] -top-[6px]" />
          <Cross class="-end-[6px] -top-[6px]" />
          <Cross class="-start-[6px] -bottom-[6px]" />
          <Cross class="-end-[6px] -bottom-[6px]" />
          <div class="grid divide-rule md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)_auto] md:divide-x">
            <div class="flex min-h-13 min-w-0 items-center gap-3 px-5 py-2">
              <span class="size-2 shrink-0 bg-(--st-warn)"></span>
              <span class="flex min-w-0 flex-col gap-0.5 sm:flex-row sm:gap-3">
                <span class="shrink-0 text-sm font-semibold">{t.band.title}</span>
                <span class="truncate text-[0.8rem] text-ink-soft">{t.band.line}</span>
              </span>
            </div>
            <div class="flex min-h-13 items-center gap-3 border-t border-rule px-5 md:border-t-0">
              <span class="font-mono text-[0.6rem] tracking-widest whitespace-nowrap text-ink-faint uppercase">
                {t.sample.days}
              </span>
              <StatusBars marks={marks} off={2} class="min-w-0 flex-1" />
              <span class="text-[0.8rem] font-semibold tabular-nums">99.96%</span>
            </div>
            <div class="flex min-h-13 items-center gap-1.5 border-t border-rule px-5 text-xs whitespace-nowrap text-ink-faint md:border-t-0">
              {t.band.by}
            </div>
          </div>
          <div class="hidden grid-cols-4 border-t border-rule divide-x divide-rule sm:grid">
            {rows.map((r) => (
              <span class="flex min-h-11 items-center justify-between gap-2 px-5 text-[0.8rem]">
                <span class="truncate">{r.name}</span>
                <span class:list={["flex shrink-0 items-center gap-1.5 text-xs", r.text]}>
                  <span class="hidden lg:inline">{r.state}</span>
                  <span class="size-1.5 shrink-0" style={`background:var(--st-${r.tone})`}></span>
                </span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>
