---
import type { HomeCopy } from "@/copy/home"
import { APP_URL } from "@/lib/routes"

interface Props {
  t: HomeCopy["hero"]
  class?: string
}

const { t } = Astro.props
---

<div class:list={["grid gap-3 sm:grid-cols-2", Astro.props.class]}>
  <a
    class="group rounded-2xl border border-signal/30 bg-brand-wash p-5 transition-colors hover:border-signal/60"
    href={`${APP_URL}/?signup=1`}
  >
    <p class="font-semibold tracking-tight">{t.hosted}</p>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{t.hostedBody}</p>
    <span class="mt-4 inline-flex h-9 items-center rounded-full bg-signal px-4 text-sm font-medium text-white transition-colors group-hover:bg-signal/90">
      {t.signUp}
    </span>
  </a>
  <a
    class="group rounded-2xl border border-rule p-5 transition-colors hover:border-rule-strong hover:bg-paper-deep"
    href={t.quickStartHref}
  >
    <p class="font-semibold tracking-tight">{t.selfHosted}</p>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{t.selfHostedBody}</p>
    <span class="mt-4 inline-flex h-9 items-center rounded-full border border-rule-strong px-4 text-sm font-medium">
      {t.quickStart}
    </span>
  </a>
</div>
