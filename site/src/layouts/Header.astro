---
import { headerCopy } from "@/copy/header"
import { i18nFor } from "@/i18n"
import { APP_URL, bcp47, brand, brandAssets, home, languageName, links, locales, type Locale } from "@/lib/routes"
import Icon from "@/ui/Icon.astro"
import Cross from "@/ui/Cross.astro"
import GitHubIcon from "@/ui/GitHubIcon.astro"
import ThemeToggle from "@/ui/ThemeToggle.astro"
import LangMenu from "@/ui/LangMenu.astro"
import Logo from "@/ui/Logo.astro"

interface Props {
  locale: Locale
  paths: Record<Locale, string>
  wide?: boolean
}

const { locale, paths, wide = false } = Astro.props
const t = headerCopy(i18nFor(locale), locale)
const item =
  "flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-start text-sm outline-none hover:bg-paper-deep focus-visible:bg-paper-deep"
---

<header class="sticky top-0 z-50 border-b border-rule before:absolute before:inset-0 before:-z-10 before:bg-paper/80 before:backdrop-blur-lg">
  <div
    class:list={[
      "relative mx-auto flex h-16 items-center gap-4 px-5 sm:px-8 lg:gap-8",
      wide ? "max-w-none lg:px-6" : "max-w-6xl border-x border-rule",
    ]}
  >
    {!wide && <Cross class="-start-[6px] -bottom-[6px]" />}
    {!wide && <Cross class="-end-[6px] -bottom-[6px]" />}
    <a class="flex shrink-0 items-center gap-2.5" href={home[locale]} aria-label={t.home} data-logo>
      <Logo size={26} />
      <span class="text-[1.02rem] font-semibold tracking-tight">Yuva</span>
    </a>
    <div
      class="fixed z-[60] min-w-60 rounded-xl border border-rule bg-sheet p-1.5 shadow-[0_16px_40px_-12px_rgb(15_23_42/0.28)]"
      role="menu"
      aria-label={t.logoMenu}
      hidden
      data-logo-menu
    >
      <button type="button" role="menuitem" class={item} data-copy-url={brandAssets.icon} data-done={t.copied}>
        <Logo size={16} />
        <span>{t.copyLogo}</span>
      </button>
      <button type="button" role="menuitem" class={item} data-copy-url={brandAssets.logo} data-done={t.copied}>
        <span class="grid size-4 place-items-center text-[0.7rem] font-semibold">Aa</span>
        <span>{t.copyWordmark}</span>
      </button>
      <a role="menuitem" class={item} href={brandAssets.icon} download="yuva-icon.svg">
        <svg
          class="size-4 text-ink-soft"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10"></path>
        </svg>
        <span>{t.downloadLogo}</span>
      </a>
      <div class="mx-2 my-1.5 h-px bg-rule" role="separator"></div>
      <a role="menuitem" class={item} href={brand[locale]}>
        <span class="size-4"></span>
        <span>{t.brand}</span>
        <span class="ms-auto text-ink-faint" aria-hidden="true">
          →
        </span>
      </a>
    </div>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t.sections} data-nav>
      <ul class="flex items-center gap-1">
        {t.groups.map((g) => (
          <li class="relative" data-nav-item>
            <button
              type="button"
              class="inline-flex h-9 cursor-pointer items-center gap-1 rounded-md px-3 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink aria-expanded:bg-paper-deep aria-expanded:text-ink"
              aria-expanded="false"
              aria-controls={`menu-${g.id}`}
              data-nav-trigger
            >
              {g.label}
              <svg
                class="size-3 text-ink-faint transition-transform [[aria-expanded=true]>&]:rotate-180"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m3 4.5 3 3 3-3" />
              </svg>
            </button>
            <div
              id={`menu-${g.id}`}
              hidden
              class:list={["absolute start-0 top-full z-[60] pt-2", g.cols === 2 ? "w-[34rem]" : "w-80"]}
            >
              <ul
                class:list={[
                  "grid gap-1 rounded-md border border-rule bg-sheet p-2 shadow-[0_16px_40px_-12px_rgb(15_23_42/0.28)]",
                  g.cols === 2 && "grid-cols-2",
                ]}
              >
                {g.items.map((i) => (
                  <li>
                    <a
                      class="flex items-start gap-3 rounded-md p-2.5 outline-none transition-colors hover:bg-paper-deep focus-visible:bg-paper-deep"
                      href={i.href}
                    >
                      <span class="grid size-8 shrink-0 place-items-center rounded-md border border-rule text-brand">
                        <Icon name={i.icon} class="size-4" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-sm font-medium">{i.title}</span>
                        <span class="mt-0.5 block text-[0.8rem] leading-snug text-ink-soft">{i.body}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ms-auto flex items-center gap-3 lg:gap-4">
      <ThemeToggle locale={locale} />
      <LangMenu locale={locale} paths={paths} class="hidden lg:block" />
      <a
        class="hidden size-8 place-items-center rounded-md text-ink-soft hover:bg-paper-deep hover:text-ink lg:grid"
        href={links.repo}
        aria-label="GitHub"
      >
        <GitHubIcon size={16} />
      </a>
      <a
        class="hidden h-9 items-center rounded-full px-3 text-sm font-medium text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink lg:inline-flex"
        href={APP_URL}
      >
        {t.logIn}
      </a>
      <a
        class="hidden h-9 items-center rounded-full bg-signal px-4 text-sm font-medium text-white transition-colors hover:bg-signal/90 lg:inline-flex"
        href={`${APP_URL}/?signup=1`}
      >
        {t.startFree}
      </a>

      <details class="group lg:hidden" data-menu>
        <summary
          class="-me-2 grid size-9 cursor-pointer list-none place-content-center gap-[5px] rounded-md [&::-webkit-details-marker]:hidden"
          aria-label={t.menu}
        >
          <span class="h-[1.5px] w-4 rounded-full bg-ink transition duration-200 group-open:translate-y-[3.25px] group-open:rotate-45"></span>
          <span class="h-[1.5px] w-4 rounded-full bg-ink transition duration-200 group-open:-translate-y-[3.25px] group-open:-rotate-45"></span>
        </summary>
        <div class="fixed inset-x-0 top-16 bottom-0 flex flex-col overflow-y-auto bg-paper px-5 pb-6 sm:px-8">
          <nav class="grid" aria-label={t.sections}>
            {t.groups.map((g) => (
              <details class="group/sec border-b border-rule">
                <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 text-base font-medium [&::-webkit-details-marker]:hidden">
                  {g.label}
                  <svg
                    class="size-4 text-ink-faint transition-transform group-open/sec:rotate-180"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m3 4.5 3 3 3-3" />
                  </svg>
                </summary>
                <ul class="grid gap-1 pb-3">
                  {g.items.map((i) => (
                    <li>
                      <a class="flex items-start gap-3 rounded-md p-2.5 hover:bg-paper-deep" href={i.href}>
                        <span class="grid size-8 shrink-0 place-items-center rounded-md border border-rule text-brand">
                          <Icon name={i.icon} class="size-4" />
                        </span>
                        <span class="min-w-0">
                          <span class="block text-sm font-medium">{i.title}</span>
                          <span class="mt-0.5 block text-[0.8rem] leading-snug text-ink-soft">{i.body}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
            {locales
              .filter((l) => l !== locale)
              .map((l) => (
                <a class="border-b border-rule py-3.5 text-base" href={paths[l]} hreflang={l} lang={bcp47[l]}>
                  {languageName(l)}
                </a>
              ))}
          </nav>
          <div class="mt-auto grid grid-cols-2 gap-3 pt-6">
            <a
              class="inline-flex h-11 items-center justify-center rounded-full border border-rule-strong text-sm font-medium"
              href={APP_URL}
            >
              {t.logIn}
            </a>
            <a
              class="inline-flex h-11 items-center justify-center rounded-full bg-signal text-sm font-medium text-white"
              href={`${APP_URL}/?signup=1`}
            >
              {t.startFree}
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const logo = document.querySelector<HTMLElement>("[data-logo]")
  const menu = document.querySelector<HTMLElement>("[data-logo-menu]")
  if (logo && menu) {
    const items = () => [...menu.querySelectorAll<HTMLElement>('[role="menuitem"]')]
    const close = () => {
      if (menu.hidden) return
      menu.hidden = true
      logo.focus({ preventScroll: true })
    }
    logo.addEventListener("contextmenu", (e) => {
      e.preventDefault()
      const r = logo.getBoundingClientRect()
      const x = e.clientX || r.left
      const y = e.clientY || r.bottom + 6
      menu.hidden = false
      menu.style.left = `${Math.min(x, window.innerWidth - menu.offsetWidth - 8)}px`
      menu.style.top = `${Math.min(y, window.innerHeight - menu.offsetHeight - 8)}px`
      items()[0]?.focus()
    })
    menu.addEventListener("keydown", (e) => {
      const list = items()
      const i = list.indexOf(document.activeElement as HTMLElement)
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault()
        const step = e.key === "ArrowDown" ? 1 : -1
        list[(i + step + list.length) % list.length]?.focus()
      } else if (e.key === "Escape" || e.key === "Tab") {
        e.preventDefault()
        close()
      }
    })
    menu.querySelectorAll<HTMLElement>("[data-copy-url]").forEach((el) => {
      el.addEventListener("click", async () => {
        const svg = await (await fetch(el.dataset.copyUrl!)).text()
        await navigator.clipboard.writeText(svg)
        const label = el.querySelector("span:last-child")!
        const before = label.textContent
        label.textContent = el.dataset.done ?? ""
        setTimeout(() => {
          label.textContent = before
          close()
        }, 900)
      })
    })
    document.addEventListener("pointerdown", (e) => {
      if (!menu.contains(e.target as Node)) close()
    })
    window.addEventListener("scroll", close, { passive: true })
    window.addEventListener("resize", close)
  }
  document.querySelectorAll<HTMLDetailsElement>("[data-menu]").forEach((d) => {
    d.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("nav a")) d.open = false
    })
  })

  const items = [...document.querySelectorAll<HTMLElement>("[data-nav-item]")]
  const parts = (item: HTMLElement) => ({
    trigger: item.querySelector<HTMLButtonElement>("[data-nav-trigger]")!,
    panel: item.querySelector<HTMLElement>("[id^='menu-']")!,
  })
  const setOpen = (item: HTMLElement, open: boolean) => {
    const { trigger, panel } = parts(item)
    trigger.setAttribute("aria-expanded", String(open))
    panel.hidden = !open
  }
  const closeAll = (except?: HTMLElement) => items.forEach((i) => i !== except && setOpen(i, false))
  const canHover = window.matchMedia("(hover: hover)")
  const timers = new Map<HTMLElement, number>()
  items.forEach((item) => {
    const { trigger, panel } = parts(item)
    trigger.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") !== "true"
      closeAll(item)
      setOpen(item, open)
    })
    trigger.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault()
        closeAll(item)
        setOpen(item, true)
        panel.querySelector<HTMLElement>("a")?.focus()
      }
    })
    item.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse" || !canHover.matches) return
      clearTimeout(timers.get(item))
      closeAll(item)
      setOpen(item, true)
    })
    item.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return
      timers.set(
        item,
        window.setTimeout(() => setOpen(item, false), 150)
      )
    })
    item.addEventListener("focusout", (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) setOpen(item, false)
    })
    item.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        setOpen(item, false)
        trigger.focus()
      }
    })
  })
  document.addEventListener("pointerdown", (e) => {
    if (!(e.target as HTMLElement).closest("[data-nav-item]")) closeAll()
  })
</script>
