---
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "@/styles/global.css"
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url"
import geistLatinExt from "@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url"
import { msg } from "@lingui/core/macro"
import Footer from "@/layouts/Footer.astro"
import Header from "@/layouts/Header.astro"
import { i18nFor } from "@/i18n"
import { absolute, bcp47, home, locales, ogLocale, type Locale } from "@/lib/routes"

interface Props {
  locale: Locale
  title: string
  description: string
  jsonLd?: object[]
  noindex?: boolean
  paths?: Record<Locale, string>
  translated?: boolean
  type?: "website" | "article"
  image?: string
  wide?: boolean
  bare?: boolean
}

const {
  locale,
  title,
  description,
  jsonLd = [],
  noindex = false,
  paths = home,
  translated = true,
  type = "website",
  image,
  wide = false,
  bare = false,
} = Astro.props
const i18n = i18nFor(locale)
const canonical = absolute(paths[locale])
const ogImage = absolute(image ?? `/og/${locale}.png`)
const serialize = (o: object) => JSON.stringify(o).replace(/</g, "\\u003c")
const preload = locale === "tr" ? [geistLatin, geistLatinExt] : [geistLatin]
---

<!doctype html>
<html lang={bcp47[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {translated && locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(paths[l])} />)}
        {translated && <link rel="alternate" hreflang="x-default" href={absolute(paths.en)} />}
      </>
    )}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      ;(function () {
        var key = "yuva.theme"
        var root = document.documentElement
        function read() {
          try {
            var c = localStorage.getItem(key)
            if (c === "light" || c === "dark") return c
          } catch (e) {}
          return "system"
        }
        function apply(choice) {
          if (choice === "system") root.removeAttribute("data-theme")
          else root.setAttribute("data-theme", choice)
          var dark = choice === "dark" || (choice === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            var own = (m.getAttribute("media") || "").indexOf("dark") > -1 ? "#09090b" : "#ffffff"
            m.setAttribute("content", choice === "system" ? own : dark ? "#09090b" : "#ffffff")
          })
          document.querySelectorAll("[data-theme-choice]").forEach(function (b) {
            b.setAttribute("aria-pressed", String(b.getAttribute("data-theme-choice") === choice))
          })
        }
        apply(read())
        document.addEventListener("DOMContentLoaded", function () {
          apply(read())
        })
        document.addEventListener("click", function (e) {
          var b = e.target instanceof Element ? e.target.closest("[data-theme-choice]") : null
          if (!b) return
          var choice = b.getAttribute("data-theme-choice")
          try {
            if (choice === "system") localStorage.removeItem(key)
            else localStorage.setItem(key, choice)
          } catch (e) {}
          apply(choice)
        })
      })()
    </script>
    {preload.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Yuva blog" href="/blog/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Yuva" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((o) => (
      <script is:inline type="application/ld+json" set:html={serialize(o)} />
    ))}
    <script
      is:inline
      defer
      data-key="yuva_ak_kRyCPt6pUzxjtJ_QuRg4FVbP"
      src="https://app.useyuva.com/yuva-analytics.js"
    ></script>
  </head>
  <body class="min-h-dvh overflow-x-clip bg-paper">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      href="#main"
    >
      {i18n._(msg`Skip to content`)}
    </a>
    {bare ? (
      <main id="main">
        <slot />
      </main>
    ) : (
      <div class="overflow-x-clip">
        <Header locale={locale} paths={paths} wide={wide} />
        <main id="main" class:list={[!wide && "mx-auto max-w-6xl border-x border-rule"]}>
          <slot />
        </main>
        <Footer locale={locale} paths={paths} wide={wide} />
      </div>
    )}
    <script is:inline src="https://app.useyuva.com/yuva.js" async></script>
    <yuva-chat channel="yuva_pk_OZ33Z-rvQRImHtjRS8PbtBQS" server="https://app.useyuva.com" locale={locale}></yuva-chat>
  </body>
</html>
