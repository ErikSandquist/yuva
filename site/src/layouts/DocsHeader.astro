---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import { href } from "@/lib/docs"
import { headerCopy } from "@/copy/header"
import { APP_URL, home, links, type Locale } from "@/lib/routes"
import Cross from "@/ui/Cross.astro"
import DocsSearch from "@/ui/DocsSearch.astro"
import GitHubIcon from "@/ui/GitHubIcon.astro"
import ThemeToggle from "@/ui/ThemeToggle.astro"
import LangMenu from "@/ui/LangMenu.astro"
import Logo from "@/ui/Logo.astro"

interface Props {
  locale: Locale
  paths: Record<Locale, string>
  section: "guides" | "api"
}

const { locale, paths, section } = Astro.props
const t = docsCopy(i18nFor(locale))
const h = headerCopy(i18nFor(locale), locale)
const tab =
  "relative flex h-14 items-center text-sm text-ink-soft transition-colors hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-px aria-[current=page]:after:h-0.5 aria-[current=page]:after:bg-signal"
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur-lg">
  <div class="flex h-14 items-stretch">
    <div
      class:list={[
        "relative flex shrink-0 items-center px-4 lg:px-5",
        section === "guides" && "lg:w-64 lg:border-e lg:border-rule",
      ]}
    >
      <a class="flex shrink-0 items-center gap-2" href={href(locale)}>
        <Logo size={24} />
        <span class="font-semibold tracking-tight">Yuva</span>
        <span class="rounded-md bg-paper-deep px-1.5 py-0.5 text-xs font-medium text-ink-soft">{t.docs}</span>
      </a>
      {section === "guides" && <Cross class="-end-[6px] -bottom-[6px] hidden lg:block" />}
    </div>
    <div class="flex min-w-0 flex-1 items-center gap-6 px-4 lg:px-5">
      <nav class="hidden items-center gap-6 md:flex" aria-label={t.documentation}>
        <a class={tab} href={href(locale)} aria-current={section === "guides" ? "page" : undefined}>
          {t.guides}
        </a>
        <a class={tab} href={href(locale, "api/")} aria-current={section === "api" ? "page" : undefined}>
          {t.apiReference}
        </a>
      </nav>
      <div class="ms-auto hidden w-full max-w-sm md:block">
        <DocsSearch locale={locale} />
      </div>
      <div class="ms-auto flex shrink-0 items-center gap-4 md:ms-0">
        <span class="md:hidden">
          <DocsSearch locale={locale} compact />
        </span>
        <ThemeToggle locale={locale} class="hidden sm:inline-flex" />
        <LangMenu locale={locale} paths={paths} class="hidden sm:block" />
        <a class="hidden text-sm text-ink-soft hover:text-ink lg:block" href={home[locale]}>
          {t.backToSite} ↗
        </a>
        <a
          class="grid size-9 place-items-center rounded-md text-ink-soft hover:bg-paper-deep hover:text-ink"
          href={links.repo}
          aria-label="GitHub"
        >
          <GitHubIcon size={18} />
        </a>
        <a
          class="hidden h-9 items-center rounded-full px-3 text-sm font-medium text-ink-soft hover:bg-paper-deep hover:text-ink md:inline-flex"
          href={APP_URL}
        >
          {h.logIn}
        </a>
        <a
          class="hidden h-9 items-center rounded-full bg-signal px-4 text-sm font-medium text-white hover:bg-signal/90 md:inline-flex"
          href={`${APP_URL}/?signup=1`}
        >
          {h.startFree}
        </a>
      </div>
    </div>
  </div>
</header>
