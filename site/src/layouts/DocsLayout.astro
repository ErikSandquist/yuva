---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { href, neighbours, nav } from "@/lib/docs"
import { headerCopy } from "@/copy/header"
import { APP_URL, bcp47, docsPath, languageName, links, locales, type Locale } from "@/lib/routes"
import ThemeToggle from "@/ui/ThemeToggle.astro"
import DocsHeader from "@/layouts/DocsHeader.astro"
import Cross from "@/ui/Cross.astro"
import DocsNav from "@/ui/DocsNav.astro"
import Icon from "@/ui/Icon.astro"

type Heading = { depth: number; slug: string; text: string }

interface Props {
  locale: Locale
  title: string
  description: string
  slug: string
  rel: string
  headings?: Heading[]
  meta?: string[]
  edit?: string
  image?: string
  wideContent?: boolean
  english?: boolean
  home?: boolean
}

const {
  locale,
  title,
  description,
  slug,
  rel,
  headings = [],
  meta = [],
  edit,
  image,
  wideContent = false,
  english = locale !== "en",
  home = false,
} = Astro.props
const t = docsCopy(i18nFor(locale))
const h = headerCopy(i18nFor(locale), locale)
const groups = await nav(locale)
const { prev, next } = await neighbours(slug, locale)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const group = groups.find((g) => g.items.some((i) => i.slug === slug))
const strip = "relative flex h-11 items-center gap-2 border-b border-rule px-5 text-[13px] text-ink-faint"
---

<Base locale={locale} title={`${title} · Yuva docs`} description={description} paths={docsPath(rel)} image={image} bare>
  <DocsHeader locale={locale} paths={docsPath(rel)} section="guides" />
  <div class="grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_15rem]">
    <aside class="hidden border-e border-rule lg:block">
      <div class="sticky top-14 flex h-[calc(100svh-3.5rem)] flex-col">
        <div class:list={[strip, "pe-3"]}>
          <span class="font-medium text-ink-soft">{t.documentation}</span>
          <Cross class="-end-[6px] -bottom-[6px]" />
        </div>
        <div class="flex-1 overflow-y-auto p-3" data-sidebar>
          <DocsNav locale={locale} groups={groups} slug={slug} label={t.documentation} />
        </div>
      </div>
    </aside>

    <div class:list={["min-w-0", wideContent && "xl:col-span-2"]}>
      <details class="group relative border-b border-rule lg:hidden">
        <summary class="flex h-11 cursor-pointer list-none items-center gap-2.5 px-5 text-sm font-medium [&::-webkit-details-marker]:hidden">
          {group && <Icon name={group.icon} class="size-4 text-brand" />}
          <span class="flex-1 truncate">{title}</span>
          <span class="text-xs text-ink-faint">{t.menu}</span>
          <svg
            class="size-4 text-ink-faint group-open:rotate-180"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="m4 6 4 4 4-4" />
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-full z-40 max-h-[70svh] overflow-y-auto border-b border-rule bg-paper p-3 shadow-paper">
          <div class="mb-3 grid gap-3 border-b border-rule px-2 pb-3 md:hidden">
            <ThemeToggle locale={locale} class="justify-self-start" />
            <p class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
              {locales
                .filter((l) => l !== locale)
                .map((l) => (
                  <a class="text-ink-soft hover:text-ink" href={docsPath(rel)[l]} hreflang={l} lang={bcp47[l]}>
                    {languageName(l)}
                  </a>
                ))}
              <a class="text-ink-soft hover:text-ink" href={links.repo}>
                GitHub
              </a>
            </p>
            <div class="grid grid-cols-2 gap-3">
              <a
                class="inline-flex h-10 items-center justify-center rounded-full border border-rule-strong text-sm font-medium"
                href={APP_URL}
              >
                {h.logIn}
              </a>
              <a
                class="inline-flex h-10 items-center justify-center rounded-full bg-signal text-sm font-medium text-white"
                href={`${APP_URL}/?signup=1`}
              >
                {h.startFree}
              </a>
            </div>
          </div>
          <DocsNav locale={locale} groups={groups} slug={slug} label={t.documentation} />
        </div>
      </details>

      <div class:list={[strip, "hidden lg:flex"]}>
        {group && <Icon name={group.icon} class="size-3.5" />}
        {group && <span>{group.title}</span>}
        {group && !home && <span aria-hidden="true">/</span>}
        {!home && <span class="truncate font-medium text-ink-soft">{title}</span>}
        {!wideContent && <Cross class="-end-[6px] -bottom-[6px] hidden xl:block" />}
      </div>

      <main class:list={["min-w-0", !home && "mx-auto max-w-3xl px-5 py-10 sm:px-8 lg:px-12 lg:py-14"]}>
        {!home && (
          <>
            <h1 class="text-[clamp(2.25rem,1.6rem+2vw,3rem)] leading-[1.06] font-semibold tracking-[-0.035em]">
              {title}
            </h1>
            <p class="mt-3 text-sm text-ink-faint">
              {[...meta.slice(0, 1), ...(english ? [t.english] : [])].join(" · ")}
            </p>
          </>
        )}
        <article class:list={["docs-content", !home && "mt-10"]} data-copy={t.copy} data-copied={t.copied}>
          <slot />
        </article>
        {edit && (
          <p class="mt-10 text-sm">
            <a class="text-ink-faint hover:text-ink" href={edit}>
              {t.edit} →
            </a>
          </p>
        )}
      </main>

      {!home && (
        <div class="relative grid grid-cols-2 border-y border-rule text-sm">
          <Cross class="-start-[6px] -top-[6px] hidden lg:block" />
          {!wideContent && <Cross class="-end-[6px] -top-[6px] hidden xl:block" />}
          {prev ? (
            <a class="block border-e border-rule p-5 hover:bg-paper-deep sm:px-8" href={href(locale, prev.rel)}>
              <span class="block text-xs text-ink-faint">← {t.previous}</span>
              <span class="mt-1 block font-medium text-ink-soft">{prev.title}</span>
            </a>
          ) : (
            <span class="border-e border-rule"></span>
          )}
          {next && (
            <a class="block p-5 text-end hover:bg-paper-deep sm:px-8" href={href(locale, next.rel)}>
              <span class="block text-xs text-ink-faint">{t.next} →</span>
              <span class="mt-1 block font-medium text-brand">{next.title}</span>
            </a>
          )}
        </div>
      )}
    </div>

    {!wideContent && (
      <aside class="hidden border-s border-rule xl:block">
        <div class="sticky top-14">
          <div class:list={[strip, "ps-5"]}>
            <span class="font-medium text-ink-soft">{t.onThisPage}</span>
          </div>
          {toc.length > 1 && (
            <nav class="max-h-[calc(100svh-6.25rem)] overflow-y-auto p-5" aria-label={t.onThisPage}>
              <ol class="border-s border-rule">
                {toc.map((h) => (
                  <li>
                    <a
                      class:list={[
                        "-ms-px block border-s border-transparent py-1 text-[13px] leading-5 transition-colors hover:border-ink hover:text-ink",
                        h.depth === 3 ? "ps-6 text-ink-faint" : "ps-3 text-ink-soft",
                      ]}
                      href={`#${h.slug}`}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>
      </aside>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".docs-content :is(h2, h3)[id]").forEach((h) => {
    const a = document.createElement("a")
    a.href = `#${h.id}`
    a.className = "heading-anchor"
    a.setAttribute("aria-hidden", "true")
    a.tabIndex = -1
    a.textContent = "#"
    h.append(a)
  })
  const article = document.querySelector<HTMLElement>(".docs-content")
  const labels: Record<string, string> = {
    sh: "Shell",
    bash: "Shell",
    yaml: "YAML",
    yml: "YAML",
    json: "JSON",
    nginx: "nginx",
    go: "Go",
    swift: "Swift",
    kotlin: "Kotlin",
    html: "HTML",
    js: "JavaScript",
    ts: "TypeScript",
    sql: "SQL",
  }
  article?.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
    const frame = document.createElement("div")
    frame.className = "code-frame"
    const bar = document.createElement("div")
    bar.className = "code-bar"
    const lang = pre.dataset.language ?? ""
    const name = document.createElement("span")
    name.textContent = labels[lang] ?? (lang === "plaintext" ? "" : lang)
    const button = document.createElement("button")
    button.type = "button"
    button.textContent = article.dataset.copy ?? "Copy"
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText)
      button.textContent = article.dataset.copied ?? "Copied"
      setTimeout(() => (button.textContent = article.dataset.copy ?? "Copy"), 1400)
    })
    bar.append(name, button)
    pre.replaceWith(frame)
    frame.append(bar, pre)
  })

  const sidebar = document.querySelector<HTMLElement>("[data-sidebar]")
  const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]')
  if (sidebar && current)
    sidebar.scrollTop +=
      current.getBoundingClientRect().top - sidebar.getBoundingClientRect().top - sidebar.clientHeight / 3
</script>
