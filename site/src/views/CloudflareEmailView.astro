---
import { cloudflareEmailCopy } from "@/copy/cloudflare-email"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { cloudflareEmailFilm } from "@/lib/promo"
import { cloudflareEmail, docsPath, links, type Locale } from "@/lib/routes"
import Lucide from "@/ui/Lucide.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = cloudflareEmailCopy(i18nFor(locale))
const card = "min-w-0 rounded-3xl border border-night-rule bg-night-sheet p-5 sm:p-8"
const num =
  "flex size-8 shrink-0 items-center justify-center rounded-full bg-glow font-mono text-sm font-semibold text-night"
const link =
  "inline-flex items-center gap-2 font-medium text-night-ink underline decoration-night-rule underline-offset-4 hover:decoration-glow"
const emailGuide = `${docsPath("email/")[locale]}#cloudflare-email-worker`
const edgeReadme = `${links.repo}/blob/main/edge/README.md`
const contract = `${edgeReadme}#ingress-contract`
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} paths={cloudflareEmail}>
  <div class="relative isolate overflow-hidden bg-night text-night-ink">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 -z-10 h-[34rem] bg-[radial-gradient(60%_60%_at_50%_0%,rgb(255_176_143/0.28),transparent_70%)]"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-5xl px-5 pt-20 pb-24 sm:px-8 sm:pt-28">
      <header class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-night-rule px-3 py-1 text-sm text-night-soft">
          <Lucide name="mail" class="size-4 text-glow" />
          {t.kicker}
        </p>
        <h1 class="mt-6 text-[clamp(2.4rem,1.3rem+3.6vw,4.2rem)] leading-[1.04] font-semibold tracking-[-0.035em]">
          {t.title}
          <span class="block text-glow">{t.titleAccent}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-night-soft">{t.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={emailGuide}
            class="inline-flex h-11 items-center rounded-full bg-glow px-5 text-[0.95rem] font-medium text-night transition-opacity hover:opacity-90"
          >
            {t.guide}
          </a>
          <a href={`${links.repo}/tree/main/edge`} class={link}>
            {t.source} →
          </a>
        </div>
      </header>

      {cloudflareEmailFilm.src && (
        <figure class="mt-14 overflow-hidden rounded-3xl border border-night-rule bg-night-sheet">
          <video
            class="aspect-video w-full"
            controls
            playsinline
            preload="none"
            poster={cloudflareEmailFilm.poster || undefined}
            aria-label={t.video.label}
          >
            <source src={cloudflareEmailFilm.src} />
          </video>
        </figure>
      )}

      <section class="mt-20" aria-labelledby="cf-what">
        <h2 id="cf-what" class="text-2xl font-semibold tracking-tight">
          {t.whatTitle}
        </h2>
        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          {t.what.map((w) => (
            <div class={card}>
              <h3 class="text-lg font-semibold">{w.title}</h3>
              <p class="mt-3 leading-relaxed text-night-soft">{w.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-20" aria-labelledby="cf-how">
        <h2 id="cf-how" class="text-2xl font-semibold tracking-tight">
          {t.howTitle}
        </h2>
        <ol class="mt-6 grid max-w-3xl gap-5">
          {t.how.map((step, i) => (
            <li class="flex gap-4">
              <span class={num}>{i + 1}</span>
              <span class="min-w-0 pt-0.5 leading-relaxed text-night-soft">{step}</span>
            </li>
          ))}
        </ol>
        <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class={card}>
            <h3 class="text-lg font-semibold">{t.refusedTitle}</h3>
            <p class="mt-3 leading-relaxed text-night-soft">{t.refused}</p>
          </div>
          <div class={card}>
            <h3 class="text-lg font-semibold">{t.fallbackTitle}</h3>
            <p class="mt-3 leading-relaxed text-night-soft">{t.fallback}</p>
          </div>
        </div>
      </section>

      <section class="mt-20" aria-labelledby="cf-setup">
        <h2 id="cf-setup" class="text-2xl font-semibold tracking-tight">
          {t.setupTitle}
        </h2>
        <p class="mt-3 text-night-soft">{t.setupLead}</p>
        <ol class="mt-6 grid max-w-3xl grid-cols-1 gap-6">
          {t.setup.map((s, i) => (
            <li class="flex min-w-0 gap-4">
              <span class={num}>{i + 1}</span>
              <div class="min-w-0 flex-1 pt-0.5">
                <p class="leading-relaxed text-night-soft">{s.text}</p>
                {s.code && <pre class="mt-3 overflow-x-auto rounded-2xl border border-night-rule bg-night p-4 font-mono text-[0.85rem] leading-relaxed text-night-ink">
                      {s.code}
                    </pre>}
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-6 max-w-3xl text-sm text-night-soft">{t.setupNote}</p>
        <a href={emailGuide} class:list={[link, "mt-4"]}>
          {t.guide} →
        </a>
      </section>

      <section class="mt-20" aria-labelledby="cf-open">
        <h2 id="cf-open" class="text-2xl font-semibold tracking-tight">
          {t.openTitle}
        </h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-night-soft">{t.open}</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
          <a href={contract} class={link}>
            {t.contract} →
          </a>
          <a href={`${docsPath("email/")[locale]}`} class={link}>
            {t.mta} →
          </a>
        </div>
      </section>

      <section class="mt-20" aria-labelledby="cf-faq">
        <h2 id="cf-faq" class="text-2xl font-semibold tracking-tight">
          {t.faqTitle}
        </h2>
        <div class="mt-6 max-w-3xl border-t border-night-rule">
          {t.faq.map((f) => (
            <details class="group border-b border-night-rule">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg leading-snug font-semibold tracking-tight [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span
                  class="relative size-8 shrink-0 rounded-full border border-night-rule group-open:rotate-45 before:absolute before:top-1/2 before:left-1/2 before:h-[1.5px] before:w-3 before:-translate-1/2 before:bg-night-ink after:absolute after:top-1/2 after:left-1/2 after:h-3 after:w-[1.5px] after:-translate-1/2 after:bg-night-ink"
                  aria-hidden="true"
                />
              </summary>
              <p class="max-w-2xl pb-6 leading-relaxed text-night-soft">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <p class="mt-20 max-w-3xl text-xs leading-relaxed text-night-soft">{t.trademark}</p>
    </div>
  </div>
</Base>
