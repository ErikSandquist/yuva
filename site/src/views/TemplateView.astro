---
import { templatesCopy } from "@/copy/templates"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { APP_URL, links, template as pagePaths, templates as galleryPaths, type Locale } from "@/lib/routes"
import { previewHtml, type Template } from "@/lib/templates"

interface Props {
  locale: Locale
  entry: Template
}

const { locale, entry } = Astro.props
const t = templatesCopy(i18nFor(locale))
const name = entry.name[locale]
const designer = `/broadcasts/designs/new?template=${entry.slug}&locale=${locale}`
const seg = "inline-flex rounded-full border border-rule-strong p-0.5"
const segButton =
  "h-8 rounded-full px-3.5 text-sm font-medium text-ink-soft transition-colors hover:text-ink aria-pressed:bg-ink aria-pressed:text-paper disabled:cursor-not-allowed disabled:opacity-40"
const link = "font-medium text-brand hover:underline"
---

<Base
  locale={locale}
  title={`${name} · ${t.metaTitle}`}
  description={t.pageDescription(name, entry.description[locale])}
  paths={pagePaths(entry.slug)}
>
  <div class="mx-auto max-w-6xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <a class="text-sm font-medium text-ink-soft hover:text-ink" href={galleryPaths[locale]}>
      ← {t.back}
    </a>
    <header class="mt-6 max-w-2xl">
      <p class="text-sm font-medium text-brand">{t.category(entry.category)}</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{name}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{entry.description[locale]}</p>
    </header>

    <div
      class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]"
      data-template
      data-slug={entry.slug}
      data-locale={locale}
      data-invalid={t.serverInvalid}
    >
      <section class="min-w-0" aria-label={t.live}>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <div class={seg} role="group" aria-label={t.width}>
            <button type="button" class={segButton} aria-pressed="true" data-width="desktop">
              {t.desktop}
            </button>
            <button type="button" class={segButton} aria-pressed="false" data-width="phone">
              {t.phone}
            </button>
          </div>
          <div class={seg} role="group" aria-label={t.scheme}>
            <button type="button" class={segButton} aria-pressed="true" data-scheme="light">
              {t.light}
            </button>
            <button type="button" class={segButton} aria-pressed="false" data-scheme="dark">
              {t.dark}
            </button>
          </div>
        </div>
        <p class="mt-3 text-sm text-ink-faint" data-dark-note hidden>
          {t.darkUnsupported}
        </p>
        <div class="mt-4 overflow-hidden rounded-2xl border border-rule bg-paper-deep p-0 sm:p-6">
          <iframe
            class="mx-auto block h-[min(80vh,56rem)] w-full max-w-[40rem] border-0 bg-white sm:rounded-lg"
            style="color-scheme: light"
            title={t.frameTitle(name)}
            src={previewHtml(entry.slug, locale)}
            sandbox=""
            loading="lazy"
            data-frame
          ></iframe>
        </div>
      </section>

      <aside class="min-w-0 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-2xl border border-rule p-5">
          <a
            class="inline-flex h-11 w-full items-center justify-center rounded-full bg-signal px-5 text-[0.95rem] font-medium text-white transition-colors hover:bg-signal/90"
            href={`${APP_URL}${designer}`}
          >
            {t.use}
          </a>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{t.useBody}</p>
        </div>

        <form class="mt-4 rounded-2xl border border-rule p-5" data-server novalidate>
          <h2 class="font-semibold tracking-tight">{t.ownServer}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{t.ownServerBody}</p>
          <label class="mt-4 block text-sm font-medium" for="server-url">
            {t.serverLabel}
          </label>
          <input
            id="server-url"
            class="mt-1.5 h-10 w-full rounded-lg border border-rule-strong bg-sheet px-3 text-sm outline-none focus-visible:border-brand"
            type="text"
            inputmode="url"
            autocomplete="url"
            autocapitalize="none"
            spellcheck="false"
            placeholder={t.serverPlaceholder}
            aria-describedby="server-error"
            data-server-input
          />
          <p class="mt-2 text-sm text-signal" id="server-error" role="alert" data-server-error hidden>
            {t.serverInvalid}
          </p>
          <button
            type="submit"
            class="mt-3 inline-flex h-10 w-full items-center justify-center rounded-full border border-rule-strong px-5 text-sm font-medium transition-colors hover:border-ink/40 hover:bg-paper-deep"
          >
            {t.serverOpen}
          </button>
        </form>

        <div class="mt-4 text-sm leading-relaxed text-ink-soft">
          <p>
            {t.license}{" "}
            <a class={link} href={links.templatesLicense}>
              {t.licenseLink}
            </a>
          </p>
          <p class="mt-2">
            {t.add}{" "}
            <a class={link} href={links.templatesGuide}>
              {t.addLink}
            </a>
          </p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-template]")
  if (root) {
    const frame = root.querySelector<HTMLIFrameElement>("[data-frame]")!
    const note = root.querySelector<HTMLElement>("[data-dark-note]")!
    const darkButton = root.querySelector<HTMLButtonElement>('[data-scheme="dark"]')!
    const press = (attr: string, value: string) =>
      root
        .querySelectorAll<HTMLButtonElement>(`[${attr}]`)
        .forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute(attr) === value)))

    root.querySelectorAll<HTMLButtonElement>("[data-width]").forEach((b) =>
      b.addEventListener("click", () => {
        const phone = b.dataset.width === "phone"
        frame.style.maxWidth = phone ? "375px" : ""
        press("data-width", b.dataset.width!)
      })
    )
    root.querySelectorAll<HTMLButtonElement>("[data-scheme]").forEach((b) =>
      b.addEventListener("click", () => {
        frame.style.colorScheme = b.dataset.scheme!
        press("data-scheme", b.dataset.scheme!)
      })
    )

    // Embedded documents follow the iframe's color-scheme only in some browsers; probe once.
    const probe = document.createElement("iframe")
    probe.setAttribute("sandbox", "allow-same-origin")
    probe.setAttribute("aria-hidden", "true")
    probe.tabIndex = -1
    probe.style.cssText =
      "position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;border:0;color-scheme:dark"
    probe.srcdoc = '<!doctype html><meta name="color-scheme" content="light dark">'
    probe.addEventListener("load", () => {
      let follows = false
      try {
        follows = probe.contentWindow!.matchMedia("(prefers-color-scheme: dark)").matches
      } catch {
        follows = false
      }
      probe.remove()
      if (!follows) {
        darkButton.disabled = true
        note.hidden = false
      }
    })
    document.body.append(probe)

    const key = "yuva-server"
    const form = root.querySelector<HTMLFormElement>("[data-server]")!
    const input = form.querySelector<HTMLInputElement>("[data-server-input]")!
    const error = form.querySelector<HTMLElement>("[data-server-error]")!
    try {
      input.value = localStorage.getItem(key) ?? ""
    } catch {
      input.value = ""
    }
    const parse = (raw: string) => {
      try {
        const url = new URL(raw.trim())
        if ((url.protocol !== "http:" && url.protocol !== "https:") || url.username || url.password) return null
        return `${url.origin}${url.pathname.replace(/\/+$/, "")}`
      } catch {
        return null
      }
    }
    input.addEventListener("input", () => (error.hidden = true))
    form.addEventListener("submit", (event) => {
      event.preventDefault()
      const base = parse(input.value)
      if (!base) {
        error.hidden = false
        input.setAttribute("aria-invalid", "true")
        input.focus()
        return
      }
      input.removeAttribute("aria-invalid")
      try {
        localStorage.setItem(key, base)
      } catch {}
      const query = new URLSearchParams({ template: root.dataset.slug!, locale: root.dataset.locale! })
      window.open(`${base}/broadcasts/designs/new?${query}`, "_blank", "noopener")
    })
  }
</script>
