---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import DocsLayout from "@/layouts/DocsLayout.astro"
import { description, docs, href, nav, translatedCount } from "@/lib/docs"
import { docsPath, type Locale } from "@/lib/routes"
import Cross from "@/ui/Cross.astro"
import Icon from "@/ui/Icon.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = docsCopy(i18nFor(locale))
const all = await docs(locale)
const englishOnly = locale !== "en" && (await translatedCount(locale)) === 0
const regions = (await nav(locale)).map((g) => ({
  ...g,
  items: g.items
    .filter((i) => i.slug !== "index")
    .map((i) => ({ ...i, text: i.slug === "api" ? t.api.description : description(all.get(i.slug)!) })),
}))
---

<DocsLayout
  locale={locale}
  title={t.home.title}
  description={t.home.description}
  slug="index"
  rel=""
  english={false}
  wideContent
  home
>
  <section class="px-5 py-12 sm:px-8 lg:px-12 lg:py-16" aria-labelledby="docs-title">
    <h1 id="docs-title" class="text-[clamp(2.25rem,1.6rem+2vw,3rem)] leading-[1.06] font-semibold tracking-[-0.035em]">
      {t.home.heading}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{t.home.lead}</p>
    {englishOnly && <p class="mt-4 text-sm text-ink-faint">{t.english}</p>}
  </section>

  {regions.map((g) => (
    <section class="relative border-t border-rule" aria-labelledby={`docs-${g.key}`}>
      <Cross class="-start-[6px] -top-[6px] hidden lg:block" />
      <h2 id={`docs-${g.key}`} class="flex items-center gap-2.5 px-5 py-3 text-sm font-medium sm:px-8 lg:px-12">
        <span class="grid size-6 place-items-center rounded-md border border-rule text-ink-soft">
          <Icon name={g.icon} class="size-3.5" />
        </span>
        {g.title}
      </h2>
      <ul class="border-t border-rule">
        {g.items.map((i) => (
          <li class="border-b border-rule last:border-b-0">
            <a
              class="group grid gap-1 px-5 py-4 transition-colors hover:bg-paper-deep sm:px-8 md:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] md:gap-8 lg:px-12"
              href={href(locale, i.rel)}
            >
              <span class="font-medium group-hover:text-brand">{i.title}</span>
              <span class="line-clamp-2 text-sm leading-relaxed text-ink-soft">{i.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>
