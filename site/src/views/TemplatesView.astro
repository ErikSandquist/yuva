---
import { templatesCopy } from "@/copy/templates"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { links, template, templates as galleryPaths, type Locale } from "@/lib/routes"
import { available, previewImage, templates } from "@/lib/templates"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = templatesCopy(i18nFor(locale))
const list = templates().filter((x) => available(x, locale))
---

<Base locale={locale} title={t.metaTitle} description={t.description} paths={galleryPaths}>
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-24 sm:px-8 sm:pt-24">
    <header class="max-w-2xl">
      <p class="text-sm font-medium text-brand">{t.kicker}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.lead}</p>
    </header>

    <ul class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((x) => (
        <li class="min-w-0">
          <a class="group block" href={template(x.slug)[locale]}>
            <span class="block aspect-[4/5] overflow-hidden rounded-2xl border border-rule bg-paper-deep transition-colors group-hover:border-rule-strong">
              <img
                class="size-full object-cover object-top"
                src={previewImage(x.slug, locale)}
                alt={t.previewOf(x.name[locale])}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="mt-4 flex items-center gap-2">
              <h2 class="text-lg font-semibold tracking-tight group-hover:text-brand">{x.name[locale]}</h2>
              <span class="rounded-full bg-brand-wash px-2 py-0.5 text-xs font-medium text-brand">
                {t.category(x.category)}
              </span>
            </span>
            <span class="mt-1.5 block leading-relaxed text-ink-soft">{x.description[locale]}</span>
            <span class="mt-3 block text-sm font-medium text-brand">{t.openCard} →</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="mt-20 max-w-2xl border-t border-rule pt-10 text-sm leading-relaxed text-ink-soft">
      <h2 class="text-base font-semibold text-ink">{t.licenseTitle}</h2>
      <p class="mt-2">
        {t.license}{" "}
        <a class="font-medium text-brand hover:underline" href={links.templatesLicense}>
          {t.licenseLink}
        </a>
      </p>
      <p class="mt-2">
        {t.add}{" "}
        <a class="font-medium text-brand hover:underline" href={links.templatesGuide}>
          {t.addLink}
        </a>
      </p>
    </section>
  </div>
</Base>
