---
import { homeCopy } from "@/copy/home"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { quickStart } from "@/lib/docs"
import { absolute, home, links, template, VERSION, type Locale } from "@/lib/routes"
import Close from "@/sections/Close.astro"
import Features from "@/sections/Features.astro"
import Hero from "@/sections/Hero.astro"
import { available, previewImage, templates } from "@/lib/templates"
import { shots } from "@/lib/shots"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = homeCopy(i18nFor(locale), await quickStart(locale))

const picks = ["welcome", "newsletter", "product-update"]
const previews = templates()
  .filter((x) => picks.includes(x.slug))
  .sort((a, b) => picks.indexOf(a.slug) - picks.indexOf(b.slug))
  .map((x) => {
    const l = available(x, locale) ? locale : "en"
    return { name: x.name[locale], src: previewImage(x.slug, l), href: template(x.slug)[locale] }
  })

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Yuva",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Linux, Docker",
    description: c.meta.description,
    url: absolute(home[locale]),
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    codeRepository: links.repo,
    softwareVersion: VERSION,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
]
---

<Base locale={locale} title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <Hero t={c.hero} shots={shots(locale)} locale={locale} alts={c.features.alts} />
  <Features t={c.features} shots={shots(locale)} previews={previews} />
  <Close t={c.close} hero={c.hero} />
</Base>
