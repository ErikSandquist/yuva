{
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // A leading underscore marks a parameter kept for its type, as in Vue emits validators.
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": [
    "**/*.gen.*",
    "**/next-env.d.ts",
    "**/src/locales/*/*.js",
    "**/src/locales/*/*.ts",
    "**/dist/",
    "**/.astro/",
    "**/.nuxt/",
    "**/.output/",
    "**/.next/",
    "**/.source/"
  ]
}
