    "colors": {
      "page": "#eef4f3",
      "card": "#ffffff",
      "text": "#1f2937",
      "muted": "#4b5563",
      "accent": "#0f766e",
      "link": "#0f766e",
      "border": "#d7e5e2"
    }
  },
  "preheader": "On 2 November Northwind moves to new data centres. Nothing changes for you.",
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "asset": "logo.png",
      "alt": "Northwind",
      "width": 150,
      "align": "left",
      "plate": true,
      "padding": [
        16,
        24,
        4,
        24
      ]
    },
    {
      "id": "hl",
      "type": "section",
      "background": "#e6f4f1",
      "border_radius": 0,
      "padding": [
        32,
        0,
        28,
        0
      ],
      "blocks": [
        {
          "id": "label",
          "type": "text",
          "html": "<p><strong>IMPORTANT · 2 NOVEMBER 2026</strong></p>",
          "size": 13,
          "padding": [
            8,
            32,
            0,
            32
          ]
        },
        {
          "id": "title",
          "type": "heading",
          "level": 1,
          "text": "We are moving to faster, greener data centres",
