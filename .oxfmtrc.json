{
  "semi": false,
  "singleQuote": false,
  "printWidth": 120,
  "trailingComma": "es5",
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.json",
    "**/*.jsonc",
    "**/*.css",
    "**/*.html",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.gen.*",
    "**/next-env.d.ts",
    "**/src/locales/*/*.js",
    "**/src/locales/*/*.ts",
    "**/dist/",
    "**/.astro/",
    "**/.nuxt/",
    "**/.output/",
    "**/.next/",
    "**/.source/"
  ]
}
